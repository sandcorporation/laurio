# 이 파일을 backend/.env 로 복사해 값을 채운다. .env 는 절대 커밋하지 않는다.
#
# 이 파일은 호스트에서 `uv run pytest` 나 `manage.py` 를 돌릴 때만 쓰인다.
# 컨테이너 안에서는 compose 가 환경변수를 직접 주입하고, 그쪽이 항상 이긴다
# (config/settings.py 의 load_dotenv override=False).
#
# 값을 비워두면 설정의 기본값이 그대로 쓰인다. 아래 항목은 전부 선택 사항이며,
# 기본값만으로도 dev compose 스택에 붙어 테스트가 돈다.

# 비워두면 개발용 임시 키를 쓴다. DJANGO_DEBUG=false 인데 비어 있으면 부팅을 거부한다.
DJANGO_SECRET_KEY=
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=*

POSTGRES_DB=laurio
POSTGRES_USER=laurio
POSTGRES_PASSWORD=laurio
POSTGRES_HOST=127.0.0.1
# dev compose 가 공개하는 포트다(LAURIO_DB_PORT 기본값 55432).
# 이 머신의 5432 는 다른 프로젝트가 쓰고 있으므로 5432 로 두면 안 된다.
POSTGRES_PORT=55432

# 티켓 11(#12)에서 LLM 어댑터가 이 키를 쓴다. ADR-0007 에 따라 어댑터 뒤에 둔다.
OPEN_AI_API_KEY=

# 티켓 04(#5) — Authentication. 비워두면 개발용 임시 키를 쓴다.
# DJANGO_DEBUG=false 인데 비어 있으면 부팅을 거부한다.
JWT_SIGNING_KEY=
ACCESS_TOKEN_TTL_MINUTES=5
REFRESH_TOKEN_TTL_DAYS=14
# fake(dev/test, 네트워크 없이 결정적) | real(카카오·GitHub·구글 실제 API 호출)
SOCIAL_AUTH_MODE=

# 티켓 06(#7) — Verification. ADR-0007 에 따라 dev/test는 fake 어댑터로 바인딩된다.
VERIFICATION_ADAPTER_MODE=
# 실명·생년월일·CI/DI 암호화 키(Fernet). 비워두면 개발용 임시 키를 쓴다.
# DJANGO_DEBUG=false 인데 비어 있으면 부팅을 거부한다.
VERIFICATION_ENCRYPTION_KEY=

# 티켓 08(#9) — 결제 · Escrow 예치. ADR-0007 에 따라 dev/test는 Fake PG 어댑터로
# 바인딩된다. fake(웹훅 재전송·타임아웃·순서 뒤바뀜을 결정적으로 주입) | real(토스)
PAYMENT_ADAPTER_MODE=
# Sponsor가 Contest 개최 시 Prize와 별도로 결제하는 개최 등록비(원 단위 정수).
CONTEST_LISTING_FEE=50000
