# 이 파일을 backend/.env 로 복사해 값을 채운다. .env 는 절대 커밋하지 않는다.
#
# 이 파일은 호스트에서 `uv run pytest` 나 `manage.py` 를 돌릴 때만 쓰인다.
# 컨테이너 안에서는 compose 가 환경변수를 직접 주입하고, 그쪽이 항상 이긴다
# (config/settings.py 의 load_dotenv override=False).
#
# 값을 비워두면 설정의 기본값이 그대로 쓰인다. 아래 항목은 전부 선택 사항이며,
# 기본값만으로도 dev compose 스택에 붙어 테스트가 돈다.

# 비워두면 개발용 임시 키를 쓴다. DJANGO_DEBUG=false 인데 비어 있으면 부팅을 거부한다.
DJANGO_SECRET_KEY=
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=*

POSTGRES_DB=laurio
POSTGRES_USER=laurio
POSTGRES_PASSWORD=laurio
POSTGRES_HOST=127.0.0.1
# dev compose 가 공개하는 포트다(LAURIO_DB_PORT 기본값 55432).
# 이 머신의 5432 는 다른 프로젝트가 쓰고 있으므로 5432 로 두면 안 된다.
POSTGRES_PORT=55432

# 티켓 11(#12)에서 LLM 어댑터가 이 키를 쓴다. ADR-0007 에 따라 어댑터 뒤에 둔다.
OPEN_AI_API_KEY=
