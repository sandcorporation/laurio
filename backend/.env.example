# 이 파일을 backend/.env 로 복사해 값을 채운다. .env 는 절대 커밋하지 않는다.
#
# 이 파일은 호스트에서 `uv run pytest` 나 `manage.py` 를 돌릴 때만 쓰인다.
# 컨테이너 안에서는 compose 가 환경변수를 직접 주입하고, 그쪽이 항상 이긴다
# (config/settings.py 의 load_dotenv override=False).
#
# 값을 비워두면 설정의 기본값이 그대로 쓰인다. 아래 항목은 전부 선택 사항이며,
# 기본값만으로도 dev compose 스택에 붙어 테스트가 돈다.

# 비워두면 개발용 임시 키를 쓴다. DJANGO_DEBUG=false 인데 비어 있으면 부팅을 거부한다.
DJANGO_SECRET_KEY=
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=*

# "이게 진짜 운영 배포인가"는 DJANGO_DEBUG와 다른 질문이다(#10 리뷰) — CI는
# DJANGO_DEBUG=false로 돌지만 운영 배포는 아니다. STORAGE_BACKEND/SOCIAL_AUTH_MODE/
# VERIFICATION_ADAPTER_MODE/PAYMENT_ADAPTER_MODE 를 fake로 둔 채 부팅을 거부하는
# 가드는 DJANGO_DEBUG가 아니라 이 값을 본다. 미설정(dev·CI 포함)은 항상 "development"고,
# prod compose(`docker/compose.prod.yaml`)만 "production"을 명시적으로 준다. 그 밖의 값은
# 부팅을 거부한다(옛 "staging" 도 마찬가지다).
CODEMIT_DEPLOYMENT_TARGET=development

POSTGRES_DB=codemit
POSTGRES_USER=codemit
POSTGRES_PASSWORD=codemit
POSTGRES_HOST=127.0.0.1
# dev compose 가 공개하는 포트다(CODEMIT_DB_PORT 기본값 55432).
# 이 머신의 5432 는 다른 프로젝트가 쓰고 있으므로 5432 로 두면 안 된다.
POSTGRES_PORT=55432

# 티켓 11(#12)에서 LLM 어댑터가 이 키를 쓴다. ADR-0007 에 따라 어댑터 뒤에 둔다.
OPEN_AI_API_KEY=

# 티켓 04(#5) — Authentication. 비워두면 개발용 임시 키를 쓴다.
# DJANGO_DEBUG=false 인데 비어 있으면 부팅을 거부한다.
JWT_SIGNING_KEY=
ACCESS_TOKEN_TTL_MINUTES=5
REFRESH_TOKEN_TTL_DAYS=14
# fake(dev/test, 네트워크 없이 결정적) | real(카카오·GitHub·구글 실제 API 호출)
SOCIAL_AUTH_MODE=

# 카카오 OAuth 앱 자격증명(#95/#96). authorize 리다이렉트・code→token 교환은
# 프론트엔드 BFF가 지므로(frontend/lib/auth/kakao.ts) 이 세 값은 실제로는
# frontend가 읽는다 — backend는 SOCIAL_AUTH_MODE=real인 배포 환경에서 이 값들이
# 비어 있으면 부팅을 거부하는 것뿐이다(config/settings.py, #83과 같은 규율).
# dev는 비워 둬도 된다 — authorize 라우트가 카카오 대신 우리 문구로 돌아간다.
# **KAKAO_REDIRECT_URI는 카카오 콘솔에 등록한 값과 한 글자도 다르면 안 된다** —
# 다르면 카카오가 code→token 교환 자체를 거절한다.
KAKAO_REST_API_KEY=
KAKAO_SECRET_KEY=
KAKAO_REDIRECT_URI=

# 티켓 06(#7) — Verification. ADR-0007 에 따라 dev/test는 fake 어댑터로 바인딩된다.
# 실물(#85)을 dev에서 켜려면 verification.adapters.PortOneV2VerificationAdapter로
# 지목하고 아래 PORT_ONE_V2_*/KG_INICIS_CHANNEL_KEY를 채운다.
VERIFICATION_ADAPTER_MODE=
# 실명·생년월일·CI/DI 암호화 키(Fernet). 비워두면 개발용 임시 키를 쓴다.
# DJANGO_DEBUG=false 인데 비어 있으면 부팅을 거부한다.
VERIFICATION_ENCRYPTION_KEY=

# 포트원(PortOne) V2 통합인증 — 채널은 KG이니시스다(#85, ADR-0024: 카카오는
# CI를 안 줘서 인증 수단에서 뺐다). VERIFICATION_ADAPTER_MODE가 real일 때만
# 필요하다 — 없으면 PortOneV2VerificationAdapter는 생성 자체를 거부한다.
# KG_INICIS_CHANNEL_KEY는 브라우저 SDK가 인증창을 열 때 쓴다(백엔드는 서버-투-
# 서버 조회만 하지만, 프론트가 같은 값을 실행 env CODEMIT_PUBLIC_PORTONE_* 로 받는다).
PORT_ONE_V2_STORE_ID=
PORT_ONE_V2_SECRET_KEY=
KG_INICIS_CHANNEL_KEY=
# tests/test_live_verification.py의 옵인 라이브 테스트 전용 — dev에서 사람이
# 브라우저로 실제 인증창을 두 번(같은 사람으로) 완료한 identityVerificationId다.
PORT_ONE_V2_LIVE_IDENTITY_VERIFICATION_ID=
PORT_ONE_V2_LIVE_IDENTITY_VERIFICATION_ID_SAME_PERSON=

# 티켓 08(#9) — 결제 · Escrow 예치. ADR-0007 에 따라 dev/test는 Fake PG 어댑터로
# 바인딩된다. fake(웹훅 재전송·타임아웃·순서 뒤바뀜을 결정적으로 주입) | real(토스)
PAYMENT_ADAPTER_MODE=
# 개최 등록비는 환경변수가 아니다(#78, ADR-0023) — 사업 정책이라
# 환경마다 같아야 하고, DB의 PlatformPolicy 단일 행(policies 앱)
# 의 contest_listing_fee에서 온다. manage.py shell로만 바꿀 수 있다(운영자
# API는 #76).
# 웹훅 서명 검증 비밀키. 비워두면 개발용 임시 키를 쓴다.
# DJANGO_DEBUG=false 인데 비어 있으면 부팅을 거부한다.
PAYMENT_WEBHOOK_SECRET=

# 티켓 12(#13) — 심사기간 · Award · 유료 연장. 마감 후 기본 심사기간, 유료
# 연장 1회의 길이, 연장 1회당 결제 금액은 더 이상 환경변수가 아니다(#78,
# ADR-0023) — PlatformPolicy의 judging_period_days·judging_extension_days·
# judging_extension_fee에서 온다.

# 티켓 02(#3): 내부 전용 엔드포인트(스케줄러 틱, notifications 내부 API) 인증 토큰.
# 비워두면 DEBUG 에서는 개발용 기본값을 쓰고, DEBUG=false 인데 비어 있으면 부팅을 거부한다.
INTERNAL_API_TOKEN=
# Celery 태스크가 내부 틱 엔드포인트를 호출할 때 쓰는 베이스 URL.
INTERNAL_API_BASE_URL=http://127.0.0.1:8000

# 티켓 02(#3): Celery. 브로커는 아직 dev compose 에 없다 — 설정만 준비해둔다.
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=

# 티켓 17(#18): notification 어댑터. 비워두면 Fake 구현체를 쓴다(ADR-0007).
NOTIFICATION_ALIMTALK_ADAPTER=
NOTIFICATION_SMS_ADAPTER=
NOTIFICATION_LMS_ADAPTER=
# 콤마로 나열한 채널의 Fake 어댑터가 실패를 흉내낸다. 예: alimtalk
NOTIFICATION_FAKE_FAILING_CHANNELS=
# 콤마로 나열한 채널의 Fake 어댑터가 (실패 응답이 아니라) 예외를 던진다. 예: alimtalk
NOTIFICATION_FAKE_RAISING_CHANNELS=

# 스토리지 어댑터 (ADR-0005, ADR-0007). 비워두면 STORAGE_BACKEND=fake 로 떨어져
# MinIO 없이 테스트가 돈다. DJANGO_SECRET_KEY 와 같은 이유로, DJANGO_DEBUG=false
# 인데 fake 로 떨어지면 부팅을 거부한다 — 배포에서 파일이 소리 없이 유실되는 것보다
# 못 뜨는 편이 낫다. dev compose 로 MinIO 에 실제로 붙어보려면 아래를 채운다 — 값은
# docker/compose.dev.yaml 의 backend 서비스가 컨테이너 안에 주입하는 것과 같다
# (호스트에서 직접 붙을 때는 CODEMIT_MINIO_PORT 로 공개된 포트를 쓴다).
STORAGE_BACKEND=
STORAGE_BUCKET=codemit-dev
STORAGE_ENDPOINT_URL=http://127.0.0.1:19000
# 비워두면 boto3 기본 자격증명 체인(IAM role 등)을 쓴다. dev(MinIO)는 정적 키가
# 필수라 여기 명시한다 — 이 값을 운영 환경 기본값으로 착각해 settings.py 에 넣지 않는다.
STORAGE_ACCESS_KEY=codemit
STORAGE_SECRET_KEY=codemit-secret
STORAGE_REGION=us-east-1

# 티켓 13(#14) — Handover. Award 후 인수 확인이 없어도 이 기간이 지나면
# 스케줄러(내부 스캔)가 Escrow를 해제한다 — 더 이상 환경변수가 아니다(#78,
# ADR-0023). PlatformPolicy.handover_acceptance_period_days에서 온다.

# 티켓 14(#15) — Payout 실행. ADR-0008에 따라 dev/test는 Fake 토스 지급대행
# 어댑터로 바인딩된다. fake(웹훅 재전송·타임아웃·순서 뒤바뀜을 결정적으로 주입) |
# real(토스 지급대행).
PAYOUT_ADAPTER_MODE=
# 웹훅 서명 검증 비밀키. 비워두면 개발용 임시 키를 쓴다.
# DJANGO_DEBUG=false 인데 비어 있으면 부팅을 거부한다.
PAYOUT_WEBHOOK_SECRET=
# 플랫폼 수수료·원천징수 공제율은 환경변수가 아니다(#75, ADR-0023) — 사업 정책이라
# 환경마다 같아야 하고, DB의 PlatformPolicy 단일 행(policies 앱)에서
# 온다. manage.py shell로만 바꿀 수 있다(운영자 API는 #76).

# 티켓 15(#16) — Distribution. 심사기간 종료(judging_ends_at) 후 이 기간
# 동안 아무도 Award하지 않으면 스케줄러가 Score 컷라인을 통과한 Submission들에게
# Prize를 1/N로 배분한다 — 더 이상 환경변수가 아니다(#78, ADR-0023).
# PlatformPolicy.distribution_wait_days에서 온다. Score 컷라인 자체(#79 범위)는
# DistributionCutline 테이블에서 조정하는 운영 파라미터라 여기 환경변수로
# 두지 않는다.

# 알림 리드타임(마감 임박·심사 종료 임박·Distribution 최종 경고)과 지급대행
# 주간 한도도 환경변수가 아니다(#78, ADR-0023) — PlatformPolicy의
# deadline_reminder_lead_hours·judging_end_reminder_lead_hours·
# distribution_final_warning_lead_days·seller_weekly_limit_amount에서 온다.
# 마지막 것은 우리 정책이 아니라 토스가 정한 사실이다(ADR-0020).

# 운영 경보(#830, `ops_metrics.alerts`) — celery beat 가 1분마다 규칙을 검사해 울리고 해소될 때
# 이 디스코드 웹훅으로 한 번씩 보낸다. 비어 있으면 보내지 않고 상태(콘솔 /ops 경보 패널)만 기록한다.
# 값은 운영자가 배포 .env 에 넣는다 — 여기에는 이름만 둔다.
OPS_ALERT_DISCORD_WEBHOOK_URL=
