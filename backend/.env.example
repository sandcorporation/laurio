# 이 파일을 .env 로 복사해 값을 채운다. .env 는 절대 커밋하지 않는다.
# compose.dev.yaml 은 개발용 값을 직접 주입하므로 컨테이너 실행에는 .env 가 필요 없다.
# 로컬에서 uv run pytest 를 돌릴 때만 쓴다.

DJANGO_SECRET_KEY=
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=*

POSTGRES_DB=laurio
POSTGRES_USER=laurio
POSTGRES_PASSWORD=laurio
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# 티켓 11(#12)에서 LLM 어댑터가 이 키를 쓴다. ADR-0007에 따라 어댑터 뒤에 둔다.
OPEN_AI_API_KEY=
