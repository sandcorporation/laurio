// ghcr 옛 버전 정리 — 매일 새벽 4시(서울)와 손으로(2026-10-02). 논리는 scripts/ci/ghcr_prune.py 에.
//
// 잡 `codemit-ghcr-prune`(Pipeline, 브랜치 `*/main`, scriptPath 이 파일)은 저장소 밖의 Jenkins 에
// 사람이 만든다. 자격증명 `ghcr-prune-token` 은 Secret text·Secret file·Username with password(비밀번호
// 칸) 어느 종류여도 된다 — 종류를 바꿀 때마다 빌드가 멈췄다(2026-10-02). 그 값은
// classic PAT(read:packages·delete:packages)이어야 한다 — fine-grained 토큰은 패키지 API 에 닿지 못한다. 예전에는 Actions
// (.github/workflows/ghcr-prune.yaml)가 GITHUB_TOKEN 으로 했다.
pipeline {
  agent { label 'built-in' }

  triggers {
    // DB 백업(2시)과 겹치지 않는 시각.
    cron('TZ=Asia/Seoul\nH 4 * * *')
  }

  parameters {
    string(name: 'KEEP_IMAGES', defaultValue: '12', trim: true, description: '이미지 패키지마다 남길 버전 수 (커밋 하나가 2개 — amd64·arm64)')
    string(name: 'KEEP_CACHE', defaultValue: '10', trim: true, description: '빌드 캐시에 남길 태그 없는 버전 수 (지금 이름의 캐시 태그 열둘은 늘 남고 옛 이름은 늘 지운다)')
    booleanParam(name: 'DRY_RUN', defaultValue: false, description: '지우지 않고 무엇을 지울지만 적는다')
  }

  options {
    timestamps()
    disableConcurrentBuilds()
    buildDiscarder(logRotator(numToKeepStr: '30'))
    timeout(time: 30, unit: 'MINUTES')
  }

  stages {
    // main·staging·production 의 끝 커밋 이미지는 몇 번째 버전이든 남긴다(#705 — 바뀌지 않은 서비스는 옛
    // 버전에 태그만 더하므로 배포 중인 이미지가 오래된 버전일 수 있다). 그 셋을 **GitHub 에서 지금** 읽는다 —
    // 체크아웃이 받아 둔 원격 브랜치는 낡았거나(이 잡은 main 만 받는다) 없을 수 있고, 예전 식은 없는 ref 를
    // 조용히 빼고 보호 없이 지웠다(#709). 셋 중 하나라도 못 풀면 지우지 않고 멈춘다.
    stage('보호할 커밋') {
      steps {
        withCredentials([usernamePassword(credentialsId: 'github-sandcorporation-token', usernameVariable: 'GH_USER', passwordVariable: 'GH_TOKEN')]) {
          sh '''
            set +x
            auth=$(printf 'x-access-token:%s' "$GH_TOKEN" | base64 | tr -d '\n')
            git -c credential.helper= -c "http.extraHeader=AUTHORIZATION: basic $auth" \
              ls-remote https://github.com/sandcorporation/laurio.git \
              refs/heads/main refs/heads/staging refs/heads/production > .prune-heads
            : > .prune-protect
            for b in main staging production; do
              s=$(awk -v r="refs/heads/$b" '$2 == r { print $1 }' .prune-heads)
              if [ -z "$s" ]; then echo "GitHub 의 $b 를 못 풀었다 — 보호 없이 지우지 않는다"; exit 1; fi
              echo "--protect-sha $s" >> .prune-protect
            done
            cat .prune-protect
          '''
        }
      }
    }

    stage('정리') {
      steps {
        script {
          // 「보호할 커밋」이 남긴 `--protect-sha …` 셋.
          def protect = '$(cat .prune-protect)'
          def prune = 'python3 scripts/ci/ghcr_prune.py --keep-images "$KEEP_IMAGES" --keep-cache "$KEEP_CACHE" $( [ "$DRY_RUN" = true ] && echo --dry-run ) ' + protect
          def fromFile = 'GH_TOKEN=$(tr -d "[:space:]" < "$GH_TOKEN_FILE") && export GH_TOKEN && '
          // 자격증명 종류가 맞지 않으면 withCredentials 가 본문을 돌기 전에 실패한다 — 그 실패만 다음 종류로 넘긴다.
          def kinds = [
            [string(credentialsId: 'ghcr-prune-token', variable: 'GH_TOKEN'), ''],
            [file(credentialsId: 'ghcr-prune-token', variable: 'GH_TOKEN_FILE'), fromFile],
            [usernamePassword(credentialsId: 'ghcr-prune-token', usernameVariable: 'GH_USER', passwordVariable: 'GH_TOKEN'), ''],
          ]
          def ran = false
          for (kind in kinds) {
            if (ran) { break }
            try {
              withCredentials([kind[0]]) {
                ran = true
                sh(kind[1] + prune)
              }
            } catch (e) {
              if (ran || !(e.message ?: '').contains('is of type')) { throw e }
              echo 'ghcr-prune-token 이 이 종류가 아니다 — 다음 종류로 읽는다'
            }
          }
        }
      }
    }
  }
}
