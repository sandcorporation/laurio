// ghcr 옛 버전 정리 — 매일 새벽 4시(서울)와 손으로(2026-10-02). 논리는 scripts/ci/ghcr_prune.py 에.
//
// 잡 `codemit-ghcr-prune`(Pipeline, 브랜치 `*/main`, scriptPath 이 파일)은 저장소 밖의 Jenkins 에
// 사람이 만든다. 자격증명 `ghcr-prune-token`(Secret text)은 classic PAT(read:packages·
// delete:packages)이어야 한다 — fine-grained 토큰은 패키지 API 에 닿지 못한다. 예전에는 Actions
// (.github/workflows/ghcr-prune.yaml)가 GITHUB_TOKEN 으로 했다.
pipeline {
  agent { label 'built-in' }

  triggers {
    // DB 백업(2시)과 겹치지 않는 시각.
    cron('TZ=Asia/Seoul\nH 4 * * *')
  }

  parameters {
    string(name: 'KEEP_IMAGES', defaultValue: '12', trim: true, description: '이미지 패키지마다 남길 버전 수 (커밋 하나가 2개 — staging·prod)')
    string(name: 'KEEP_CACHE', defaultValue: '10', trim: true, description: '빌드 캐시에 남길 버전 수')
    booleanParam(name: 'DRY_RUN', defaultValue: false, description: '지우지 않고 무엇을 지울지만 적는다')
  }

  options {
    timestamps()
    disableConcurrentBuilds()
    buildDiscarder(logRotator(numToKeepStr: '30'))
    timeout(time: 30, unit: 'MINUTES')
  }

  stages {
    stage('정리') {
      steps {
        withCredentials([string(credentialsId: 'ghcr-prune-token', variable: 'GH_TOKEN')]) {
          sh '''
            python3 scripts/ci/ghcr_prune.py --keep-images "$KEEP_IMAGES" --keep-cache "$KEEP_CACHE" \
              $( [ "$DRY_RUN" = true ] && echo --dry-run )
          '''
        }
      }
    }
  }
}
