# 시크릿 — 절대 커밋하지 않는다.
# 부정 규칙은 반드시 마지막에 둔다. 뒤에 오는 무시 규칙이 이기기 때문이다.
.env
.env.*
*/.env
*/.env.*
!.env.example
!*/.env.example

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/
htmlcov/
.coverage
.coverage.*

# Django — 앵커를 붙이지 않는다. STATIC_ROOT 는 backend/staticfiles 다.
*.sqlite3
media/
staticfiles/

# 도구·에디터
.idea/
.vscode/
.DS_Store

# 로컬 산출물
.scratch/

# 디자인 캔버스 생성 산출물 — design/*.dc.html + canvas.json 에서 다시 만든다
design/*.html
!design/*.dc.html

# 하네스가 관리하는 에이전트 워크트리 — 저장소에 들어가면 안 된다.
# .claude/ 전체가 아니라 worktrees 만 무시한다 — 나중에 .claude/settings.json 같은
# 프로젝트 설정을 커밋해야 할 때 조용히 누락되지 않도록.
.claude/worktrees/

# playwright MCP 도구가 남기는 산출물
/.playwright-mcp/

# pnpm 워크스페이스(운영자 앱 04 #62) — 앱마다 자기 .gitignore 도 갖고 있지만,
# packages/* 는 별도 .gitignore 가 없으므로 여기서 한 번에 덮는다. 슬래시 없는
# 패턴은 모든 깊이에서 매치되므로 frontend/node_modules 도 이 규칙 하나로 커버된다.
node_modules/
/.pnpm-store/
.jenkins-staging-deployed
