// 묶음 병합 큐 (2026-10-03) — 줄 선 PR 을 최신 main 위에 쌓아 한 번 시험하고, 초록이면 차례로 합친다.
//
// 잡 `codemit-train`(Pipeline, main 의 이 파일). PR CI(`Jenkinsfile.pr`)가 sub 검사를 통과한 커밋을
// 줄 세우고(`codemit/automerge` = pending) 이 잡을 부른다. 초안을 풀거나 `hold` 를 떼거나 다시 연 PR 은
// push 가 없어 PR CI 가 부르지 않는다 — GitHub 의 `pull_request` 웹훅이 그때 이 잡을 깨운다(#709, 아래
// `triggers`). 30분마다도 스스로 돈다(뒷받침). 고르기·쌓기·가르기 규칙은 `scripts/ci/train.py` 머리말에 있다.
//
// 노드: 쌓기·병합은 sub, 시험은 sub(검사 전체)와 macos(e2e·celery)가 함께. 묶음이 PR 마다의 시험을
// 대신하는 것은 macos 쪽이다 — sub 검사는 PR 마다 한 번(줄 서기 전 거르개)과 묶음에서 한 번 돈다.
// 같은 잡을 둘 겹쳐 돌리지 않는다 — 줄에 쌓인 호출은 Jenkins 가 하나로 합친다.
pipeline {
  agent none

  parameters {
    string(name: 'MAX_PRS', defaultValue: '0', description: '이번 묶음의 PR 상한 — 0 이면 기본(8). 붉은 묶음을 반으로 가를 때 잡이 스스로 채운다')
  }

  triggers {
    // 웹훅이 빠졌을 때의 뒷받침 — 2026-10-15 까지는 이것(10분)이 hold·초안을 푼 PR 을 데려오는 유일한 길이었다.
    cron('H/30 * * * *')
    // GitHub 웹훅(`pull_request` 이벤트만) → `/generic-webhook-trigger/invoke?token=…`. 토큰은 Jenkins 자격증명
    // `codemit-train-webhook-token`(Secret text). push 가 없는 세 가지 — `hold` 를 뗐다·초안을 풀었다·다시
    // 열었다 — 만 통과시킨다. opened·synchronize·labeled·closed 는 PR CI 가 push 로 다루므로 열차를 부르지
    // 않는다. 이미 돌고 있으면 큐에 하나로 합쳐진다(disableConcurrentBuilds).
    // Jenkins 는 이 블록을 **잡이 한 번 돈 뒤에** 잡에 반영한다 — 바꾼 뒤 첫 빌드(cron)부터 듣는다.
    GenericTrigger(
      genericVariables: [
        [key: 'action', value: '$.action'],
        [key: 'label', value: '$.label.name'],
        [key: 'draft', value: '$.pull_request.draft'],
        [key: 'base', value: '$.pull_request.base.ref'],
        [key: 'state', value: '$.pull_request.state'],
      ],
      genericHeaderVariables: [
        [key: 'X-GitHub-Event', regexpFilter: ''],
      ],
      tokenCredentialId: 'codemit-train-webhook-token',
      causeString: 'PR 웹훅: $action $label',
      printContributedVariables: false,
      printPostContent: false,
      silentResponse: false,
      regexpFilterText: '$x_github_event $action $draft $base $state $label',
      regexpFilterExpression: '^pull_request ((ready_for_review|reopened) false main open ?|unlabeled false main open hold)$'
    )
  }

  environment {
    CODEMIT_CI_RUN_ID = "${env.BUILD_TAG}-${currentBuild.startTimeInMillis}"
  }

  options {
    timestamps()
    disableConcurrentBuilds()
    timeout(time: 45, unit: 'MINUTES')
    buildDiscarder(logRotator(numToKeepStr: '50'))
  }

  stages {
    stage('묶기') {
      agent { label 'laurio-staging' }
      steps {
        withCredentials([usernamePassword(credentialsId: 'github-sandcorporation-token', usernameVariable: 'GH_USER', passwordVariable: 'GH_TOKEN')]) {
          sh 'python3 scripts/ci/train.py plan --max "${MAX_PRS:-0}"'
        }
        stash name: 'plan', includes: 'train.plan'
        script {
          readFile('train.env').trim().split('\n').each { line ->
            def kv = line.tokenize('=')
            env."TRAIN_${kv[0]}" = kv[1]
          }
          currentBuild.description = sh(returnStdout: true,
            script: 'python3 -c "import json;print(\' \'.join(\'#%d\' % e[\'number\'] for e in json.load(open(\'train.plan\'))[\'entries\']) or \'빈 묶음\')"').trim()
        }
      }
    }

    stage('시험') {
      when {
        beforeAgent true
        expression { env.TRAIN_COUNT != '0' }
      }
      failFast false
      parallel {
        stage('sub — 백엔드·단위·검사') {
          when {
            beforeAgent true
            expression { env.TRAIN_RUN_TESTS == '1' }
          }
          agent { label 'laurio-staging' }
          steps {
            unstash 'plan'
            withCredentials([usernamePassword(credentialsId: 'github-sandcorporation-token', usernameVariable: 'GH_USER', passwordVariable: 'GH_TOKEN')]) {
              sh 'python3 scripts/ci/train.py assemble'
            }
            sh 'bash scripts/ci/sub-checks.sh'
          }
          post {
            always {
              junit keepProperties: true, testResults: 'test-results/backend-junit.xml', allowEmptyResults: true
              archiveArtifacts artifacts: 'test-results/summary.txt', allowEmptyArchive: true
            }
          }
        }
        stage('macos — e2e·celery') {
          when {
            beforeAgent true
            expression { env.TRAIN_RUN_TESTS == '1' }
          }
          agent { label 'macos' }
          steps {
            unstash 'plan'
            withCredentials([usernamePassword(credentialsId: 'github-sandcorporation-token', usernameVariable: 'GH_USER', passwordVariable: 'GH_TOKEN')]) {
              sh 'python3 scripts/ci/train.py assemble'
            }
            // 중단된 앞 빌드가 남긴 스택·디스크부터 걷는다(trap 은 중단 때 돌지 못한다).
            sh 'bash scripts/ci/macos-sweep.sh'
            // e2e 가 붉어도 celery-broker 는 돈다 — 어디가 깨졌는지 한 번에 본다.
            catchError(buildResult: 'FAILURE', stageResult: 'FAILURE') {
              sh 'bash scripts/ci/e2e.sh'
            }
            sh 'bash scripts/ci/celery-broker.sh'
          }
          post {
            always {
              archiveArtifacts artifacts: 'test-results/**', allowEmptyArchive: true
            }
          }
        }
        stage('문서만') {
          when {
            beforeAgent true
            expression { env.TRAIN_RUN_TESTS == '0' }
          }
          agent { label 'laurio-staging' }
          steps {
            unstash 'plan'
            withCredentials([usernamePassword(credentialsId: 'github-sandcorporation-token', usernameVariable: 'GH_USER', passwordVariable: 'GH_TOKEN')]) {
              sh 'python3 scripts/ci/train.py assemble'
            }
            sh 'python3 scripts/check_adr_status.py'
          }
        }
      }
    }

    stage('병합') {
      when {
        beforeAgent true
        expression { env.TRAIN_COUNT != '0' && currentBuild.currentResult == 'SUCCESS' }
      }
      agent { label 'laurio-staging' }
      steps {
        unstash 'plan'
        sh 'rm -f .train-merged'
        withCredentials([usernamePassword(credentialsId: 'github-sandcorporation-token', usernameVariable: 'GH_USER', passwordVariable: 'GH_TOKEN')]) {
          sh 'python3 scripts/ci/train.py assemble'
          sh 'python3 scripts/ci/train.py merge'
        }
        // 합쳤으면 합친 범위의 `GlitchTip: <id>` 줄을 해결 표시한다 — 「고쳤다」의 판정이 곧 이
        // 병합이다(시험이 초록이고 main 에 들어갔다). 토큰이 없으면 스크립트가 넘어간다.
        script {
          if (fileExists('.train-merged')) {
            catchError(buildResult: null, stageResult: null, message: 'GlitchTip 표시 실패 — 병합과 무관하다') {
              withCredentials([string(credentialsId: 'glitchtip-automation-token', variable: 'GLITCHTIP_TOKEN_FOR_AUTOMATION')]) {
                sh 'python3 scripts/glitchtip_resolve.py $(cat .train-merged)'
              }
            }
          }
        }
      }
    }
  }

  post {
    // 묶음이 비지 않았으면 다음 묶음을 부른다 — 붉었으면 반으로 갈라서, 초록이면 남은 줄을.
    // 빈 묶음은 부르지 않는다(30분 cron·PR CI·pull_request 웹훅이 부른다).
    failure {
      script {
        if (env.TRAIN_COUNT && env.TRAIN_COUNT != '0') {
          node('laurio-staging') {
            unstash 'plan'
            withCredentials([usernamePassword(credentialsId: 'github-sandcorporation-token', usernameVariable: 'GH_USER', passwordVariable: 'GH_TOKEN')]) {
              sh 'python3 scripts/ci/train.py fail'
            }
            def next = readFile('train.next').trim().tokenize('=')[1]
            build job: env.JOB_NAME, wait: false, parameters: [string(name: 'MAX_PRS', value: next)]
          }
        }
      }
    }
    success {
      script {
        if (env.TRAIN_COUNT && env.TRAIN_COUNT != '0') {
          build job: env.JOB_NAME, wait: false, parameters: [string(name: 'MAX_PRS', value: '0')]
        }
      }
    }
  }
}
