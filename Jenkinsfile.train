// 묶음 병합 큐 (2026-10-03) — 줄 선 PR 을 최신 main 위에 쌓아 한 번 시험하고, 초록이면 차례로 합친다.
//
// 잡 `codemit/ci-train`(#780 전에는 `codemit-ci-train`; Pipeline, main 의 이 파일). PR CI(`Jenkinsfile.pr`)가 sub 검사를 통과한 커밋을
// 줄 세우고(`codemit/automerge` = pending) 이 잡을 부른다. 초안을 풀거나 `hold` 를 떼거나 다시 연 PR 은
// push 가 없어 PR CI 가 부르지 않는다 — GitHub 의 `pull_request` 웹훅이 그때 이 잡을 깨운다(#709, 아래
// `triggers`). 30분마다도 스스로 돈다(뒷받침). 고르기·쌓기·가르기 규칙은 `scripts/ci/train.py` 머리말에 있다.
//
// 노드: 쌓기·병합은 sub, 시험은 sub(검사 전체)와 macos(이미지·e2e·celery)가 함께. 묶음이 PR 마다의 시험을
// 대신하는 것은 macos 쪽이다 — sub 검사는 PR 마다 한 번(줄 서기 전 거르개)과 묶음에서 한 번 돈다.
//
// **배포 이미지도 여기서 굽는다**(#712). macos 가 arm64 여섯(+ 구운 앱의 부팅 가드, #838 — prod 에 가는
// 이미지)을 `scripts/ci/images.sh` 로 굽고, macos 의 e2e·celery 는 그 arm64 이미지를 받아 돈다.
// sub 는 amd64 를 굽지 않는다(#841, staging 제거 — 배포는 arm64 하나다).
// 시험 둘이 초록이면 「병합」 단계가 **병합 전에** `images-ctx.sh` 로 ctx 태그를 붙이고(#729), 병합 뒤
// `codemit/deploy`(`Jenkinsfile`)는 같은 문맥을 전부 「건너뛴다」로 두고 main 커밋 태그만 더한다 — 같은
// 코드를 두 번 굽지 않고, 건너뛰기만 할 때는 macos 도 잡지 않는다.
// 같은 잡을 둘 겹쳐 돌리지 않는다 — 줄에 쌓인 호출은 Jenkins 가 하나로 합친다.
pipeline {
  agent none

  parameters {
    string(name: 'MAX_PRS', defaultValue: '0', description: '이번 묶음의 PR 상한 — 0 이면 기본(8). 붉은 묶음을 반으로 가를 때 잡이 스스로 채운다')
    string(name: 'INFRA_RETRY', defaultValue: '0', description: '1 이면 이 가르기 사슬이 인프라 재실행(e2e 의 backend 요청 0건 틈 — VM 정지와 워커 고갈을 가르지 못한다 — 또는 이미지 굽기의 인프라 실패, #716)을 이미 썼다 — 같은 묶음을 다시 도는 빌드와 그 뒤 가른 묶음이 받는다. 잡이 스스로 채우고, 판정을 다시 읽지 않는다(#718)')
  }

  triggers {
    // 웹훅이 빠졌을 때의 뒷받침 — 2026-10-15 까지는 이것(10분)이 hold·초안을 푼 PR 을 데려오는 유일한 길이었다.
    cron('H/30 * * * *')
    // GitHub 웹훅(`pull_request` 이벤트만) → `/generic-webhook-trigger/invoke?token=…`. 토큰은 Jenkins 자격증명
    // `codemit-train-webhook-token`(Secret text — 잡 이름이 아니라 자격증명 ID 라 #708 에서 그대로 뒀다). push 가 없는 세 가지 — `hold` 를 뗐다·초안을 풀었다·다시
    // 열었다 — 만 통과시킨다. opened·synchronize·labeled·closed 는 PR CI 가 push 로 다루므로 열차를 부르지
    // 않는다. 이미 돌고 있으면 큐에 하나로 합쳐진다(disableConcurrentBuilds).
    // Jenkins 는 이 블록을 **잡이 한 번 돈 뒤에** 잡에 반영한다 — 바꾼 뒤 첫 빌드(cron)부터 듣는다.
    GenericTrigger(
      genericVariables: [
        [key: 'action', value: '$.action'],
        [key: 'label', value: '$.label.name'],
        [key: 'draft', value: '$.pull_request.draft'],
        [key: 'base', value: '$.pull_request.base.ref'],
        [key: 'state', value: '$.pull_request.state'],
      ],
      genericHeaderVariables: [
        [key: 'X-GitHub-Event', regexpFilter: ''],
      ],
      tokenCredentialId: 'codemit-train-webhook-token',
      causeString: 'PR 웹훅: $action $label',
      printContributedVariables: false,
      printPostContent: false,
      silentResponse: false,
      regexpFilterText: '$x_github_event $action $draft $base $state $label',
      regexpFilterExpression: '^pull_request ((ready_for_review|reopened) false main open ?|unlabeled false main open hold)$'
    )
  }

  environment {
    CODEMIT_CI_RUN_ID = "${env.BUILD_TAG}-${currentBuild.startTimeInMillis}"
  }

  options {
    timestamps()
    disableConcurrentBuilds()
    timeout(time: 45, unit: 'MINUTES')
    buildDiscarder(logRotator(numToKeepStr: '50'))
  }

  stages {
    stage('묶기') {
      agent { label 'built-in' }
      steps {
        withCredentials([usernamePassword(credentialsId: 'github-sandcorporation-token', usernameVariable: 'GH_USER', passwordVariable: 'GH_TOKEN')]) {
          sh 'python3 scripts/ci/train.py plan --max "${MAX_PRS:-0}"'
        }
        stash name: 'plan', includes: 'train.plan'
        script {
          readFile('train.env').trim().split('\n').each { line ->
            def kv = line.tokenize('=')
            env."TRAIN_${kv[0]}" = kv[1]
          }
          currentBuild.description = sh(returnStdout: true,
            script: 'python3 -c "import json;print(\' \'.join(\'#%d\' % e[\'number\'] for e in json.load(open(\'train.plan\'))[\'entries\']) or \'빈 묶음\')"').trim()
        }
      }
    }

    stage('시험') {
      when {
        beforeAgent true
        expression { env.TRAIN_COUNT != '0' }
      }
      failFast false
      parallel {
        stage('sub — 백엔드·단위·검사') {
          when {
            beforeAgent true
            expression { env.TRAIN_RUN_TESTS == '1' }
          }
          agent { label 'built-in' }
          steps {
            unstash 'plan'
            withCredentials([usernamePassword(credentialsId: 'github-sandcorporation-token', usernameVariable: 'GH_USER', passwordVariable: 'GH_TOKEN')]) {
              sh 'python3 scripts/ci/train.py assemble'
            }
            sh 'bash scripts/ci/sub-checks.sh'
            script { env.TRAIN_SUB_GREEN = '1' }
          }
          post {
            always {
              junit keepProperties: true, testResults: 'test-results/backend-junit.xml', allowEmptyResults: true
              archiveArtifacts artifacts: 'test-results/summary.txt', allowEmptyArchive: true
            }
          }
        }
        stage('macos — e2e·celery') {
          when {
            beforeAgent true
            expression { env.TRAIN_RUN_TESTS == '1' }
          }
          agent { label 'macos' }
          steps {
            unstash 'plan'
            withCredentials([usernamePassword(credentialsId: 'github-sandcorporation-token', usernameVariable: 'GH_USER', passwordVariable: 'GH_TOKEN')]) {
              sh 'python3 scripts/ci/train.py assemble'
            }
            // 중단된 앞 빌드가 남긴 스택·디스크부터 걷는다(trap 은 중단 때 돌지 못한다).
            sh 'bash scripts/ci/macos-sweep.sh'
            withCredentials([string(credentialsId: 'ghcr-push-token', variable: 'GHCR_TOKEN')]) {
              // prod(arm64) 여섯을 묶음의 트리로 굽고 커밋 태그로 올린다(#712) — 바뀌지 않은 것은 ctx 로
              // 건너뛴다. e2e·celery 는 스택이 따로 굽지 않고 **바로 이 이미지**를 받아 돈다
              // (compose.ci-images.yaml) — 그래서 e2e 가 본 digest 가 prod 에 가는 digest 다.
              // 붉으면 레지스트리·buildx 탓인지 가려(#729) e2e 판정과 같은 자리에 남긴다 — e2e 는 돌지 않는다.
              script {
                if (sh(returnStatus: true, script: 'bash scripts/ci/images.sh arm64') != 0) {
                  sh 'mkdir -p test-results && python3 scripts/ci/e2e_stall.py images arm64 > test-results/e2e-verdict.json || rm -f test-results/e2e-verdict.json'
                  stash name: 'e2e-verdict', includes: 'test-results/e2e-verdict.json', allowEmpty: true
                  error('arm64 이미지 굽기가 붉다 — 위의 서비스별 로그')
                }
              }
              // 이번에 구운 앱만 부팅 가드(#838) — prod 에 가는 arm64 이미지를 네이티브로 본다. e2e 앞에 두어
              // 빨리 실패한다. 붉으면 판정 파일 없이 끝나므로 post 는 인프라로 보지 않고 가른다(코드 실패).
              // 건너뛴 앱은 ctx 가 붙을 때 이미 한 번 지났다.
              sh '''
                for app in frontend operator classroom; do
                  if grep -qx "$app=built" .images-arm64.result; then CODEMIT_GUARD_ARCH=arm64 bash scripts/ci/deploy-guard.sh "$app"; fi
                done
              '''
              // 커밋 태그는 images.sh 가 쓴 그것 — 이 작업 공간의 HEAD(쌓은 묶음의 머리) + `-arm64`.
              // e2e 가 붉어도 celery-broker 는 돈다 — 어디가 깨졌는지 한 번에 본다.
              catchError(buildResult: 'FAILURE', stageResult: 'FAILURE') {
                sh 'CODEMIT_IMAGE_TAG="$(git -c safe.directory="$PWD" rev-parse HEAD)-arm64" bash scripts/ci/e2e.sh'
                script { env.TRAIN_E2E_OK = '1' }
              }
              // 붉은 e2e 가 backend 요청 0건 틈(3초 초과 + 그 시각 backend 요청 0건 — VM 정지와 워커 고갈을 가르지 못한다)
              // 모양인지 판정한다(#716, #723).
              // celery-broker 까지 초록일 때만 넘긴다 — 다른 단계가 붉으면 인프라 재실행 대상이 아니다.
              sh 'python3 scripts/ci/e2e_stall.py test-results > test-results/e2e-verdict.json || rm -f test-results/e2e-verdict.json'
              sh 'CODEMIT_IMAGE_TAG="$(git -c safe.directory="$PWD" rev-parse HEAD)-arm64" bash scripts/ci/celery-broker.sh'
            }
            stash name: 'e2e-verdict', includes: 'test-results/e2e-verdict.json', allowEmpty: true
            stash name: 'ctx-arm64', includes: '.images-arm64.ctx', allowEmpty: true
            // e2e 가 받은 arm64 digest — 「병합」이 `e2e-<트리>-arm64` 태그로 남긴다(#729, prod 의 e2e 대조).
            stash name: 'e2e-images', includes: 'test-results/images.txt', allowEmpty: true
            script { if (env.TRAIN_E2E_OK == '1') { env.TRAIN_MACOS_GREEN = '1' } }
          }
          post {
            always {
              archiveArtifacts artifacts: 'test-results/**', allowEmptyArchive: true
            }
          }
        }
        stage('문서만') {
          when {
            beforeAgent true
            expression { env.TRAIN_RUN_TESTS == '0' }
          }
          agent { label 'built-in' }
          steps {
            unstash 'plan'
            withCredentials([usernamePassword(credentialsId: 'github-sandcorporation-token', usernameVariable: 'GH_USER', passwordVariable: 'GH_TOKEN')]) {
              sh 'python3 scripts/ci/train.py assemble'
            }
            sh 'python3 scripts/check_adr_status.py'
          }
        }
      }
    }

    stage('병합') {
      when {
        beforeAgent true
        expression { env.TRAIN_COUNT != '0' && currentBuild.currentResult == 'SUCCESS' }
      }
      agent { label 'built-in' }
      steps {
        unstash 'plan'
        sh 'rm -f .train-merged'
        // 시험 둘이 초록이면 **병합 전에** 이 묶음이 구운 이미지에 ctx 태그를 붙인다(#712, #729). 열차에서
        // 초록은 시험 두 가지(검사 / 이미지·가드·e2e·celery)다. 병합 push 가 깨운 `codemit/deploy`
        // 이 같은 트리의 문맥 해시를 내면 전부 「건너뛴다」가 되어 macos 를 잡지 않고 커밋 태그만 더한다
        // (Jenkinsfile 「대상 확인」의 retag) — 병합 뒤에 붙이면 그 잡이 ctx 보다 먼저 떠 같은 트리를 다시 구웠다.
        // ctx 는 「이 문맥을 어느 빌드가 끝까지 초록으로 봤다」는 내용 기준의 사실이라, 병합이 거절되거나
        // (그 사이 새 push) 다 합치지 못해도 무해하다 — main 의 트리가 다르면 배포 잡이 다른 해시를 내고 그
        // 문맥만 굽는다. 붉은 묶음은 여기 닿지 않아 ctx 가 없고, 반으로 갈라 다시 도는 묶음은 트리가 달라
        // 해시도 다르니 스스로 다시 굽는다. 실패해도 빌드를 붉히지 않는다 — 배포 잡이 구울 뿐이다.
        script {
          if (env.TRAIN_RUN_TESTS == '1') {
            // 둘 다 5분 안에 끝나야 한다(#738). 레지스트리가 오류를 내면 catchError 가 잡지만, `imagetools create`
            // 가 오류 없이 멈추면 파이프라인 45분 제한까지 병합이 묶이고 ABORTED 라 병합도 `post failure` 도 없다.
            // timeout 의 중단(FlowInterruptedException)은 catchError 의 기본값 `catchInterruptions: true` 가 잡는다
            // (pipeline-basic-steps 문서: 「timeout 단계가 던지는 것」을 예로 든다) — 그래서 timeout 은 catchError
            // **안에** 둔다. 밖에 두면 중단이 catchError 를 지나 단계를 끝낸다.
            catchError(buildResult: null, stageResult: null, message: 'ctx 태그 실패 — 배포 잡이 다시 굽는다') {
              timeout(time: 5, unit: 'MINUTES') {
                unstash 'ctx-arm64'
                withCredentials([string(credentialsId: 'ghcr-push-token', variable: 'GHCR_TOKEN')]) {
                  sh 'bash scripts/ci/images-ctx.sh .images-arm64.ctx'
                }
              }
            }
            // e2e 가 본 arm64 이미지에 이 묶음의 트리를 태그로 — prod 가 `deploy.sh prod e2e-digest` 로 견준다(#729).
            catchError(buildResult: null, stageResult: null, message: 'e2e 태그 실패 — prod 의 e2e 대조가 「대조 못 함」이 될 뿐이다') {
              timeout(time: 5, unit: 'MINUTES') {
                sh 'rm -f test-results/images.txt'
                unstash 'e2e-images'
                withCredentials([string(credentialsId: 'ghcr-push-token', variable: 'GHCR_TOKEN')]) {
                  sh 'bash scripts/ci/images-e2e.sh test-results/images.txt "$(python3 -c \'import json;print(json.load(open("train.plan"))["tree"])\')"'
                }
              }
            }
          }
        }
        withCredentials([usernamePassword(credentialsId: 'github-sandcorporation-token', usernameVariable: 'GH_USER', passwordVariable: 'GH_TOKEN')]) {
          sh 'python3 scripts/ci/train.py assemble'
          sh 'python3 scripts/ci/train.py merge'
        }
        // 합쳤으면 합친 범위의 `GlitchTip: <id>` 줄을 해결 표시한다 — 「고쳤다」의 판정이 곧 이
        // 병합이다(시험이 초록이고 main 에 들어갔다). 토큰이 없으면 스크립트가 넘어간다.
        script {
          if (fileExists('.train-merged')) {
            catchError(buildResult: null, stageResult: null, message: 'GlitchTip 표시 실패 — 병합과 무관하다') {
              withCredentials([string(credentialsId: 'glitchtip-automation-token', variable: 'GLITCHTIP_TOKEN_FOR_AUTOMATION')]) {
                sh 'python3 scripts/glitchtip_resolve.py $(cat .train-merged)'
              }
            }
          }
        }
      }
    }
  }

  post {
    // 묶음이 비지 않았으면 다음 묶음을 부른다 — 붉었으면 반으로 갈라서, 초록이면 남은 줄을.
    // 빈 묶음은 부르지 않는다(30분 cron·PR CI·pull_request 웹훅이 부른다).
    failure {
      script {
        if (env.TRAIN_COUNT && env.TRAIN_COUNT != '0') {
          node('built-in') {
            unstash 'plan'
            // 인프라 판정(#716, #729) — 앞 빌드가 이 작업 공간에 남긴 것을 지우고, 이번 빌드가 남긴 것만 읽는다.
            // 붉은 쪽마다 판정이 있어야 넘긴다: sub 는 검사뿐이라 판정이 없다(붉으면 코드 실패), macos 는
            // 이미지 굽기가 붉었거나 e2e 가 붉고 celery 까지 돌았을 때만(가드가 붉으면 판정이 없다).
            // 판정이 없는 붉은 쪽이 하나라도 있으면 아무것도 넘기지 않는다 — 가른다. 전부 인프라인지는 train.py 가 본다.
            sh 'rm -f test-results/e2e-verdict.json'
            def failArgs = ''
            def verdicts = []
            def judgeable = true
            if (env.TRAIN_SUB_GREEN != '1') { judgeable = false }
            if (env.TRAIN_MACOS_GREEN != '1') {
              try { unstash 'e2e-verdict' } catch (ignored) { }
              if (fileExists('test-results/e2e-verdict.json')) { verdicts << 'test-results/e2e-verdict.json' }
              else { judgeable = false }
            }
            if (judgeable && verdicts) {
              for (v in verdicts) { failArgs += " --verdict ${v}" }
            }
            if ((params.INFRA_RETRY ?: '0') == '1') { failArgs += ' --infra-retried' }
            withCredentials([usernamePassword(credentialsId: 'github-sandcorporation-token', usernameVariable: 'GH_USER', passwordVariable: 'GH_TOKEN')]) {
              sh "python3 scripts/ci/train.py fail${failArgs}"
            }
            def next = [:]
            readFile('train.next').trim().split('\n').each { line ->
              def kv = line.tokenize('=')
              next[kv[0]] = kv[1]
            }
            build job: env.JOB_NAME, wait: false, parameters: [
              string(name: 'MAX_PRS', value: next.NEXT_MAX),
              string(name: 'INFRA_RETRY', value: next.INFRA_RETRY ?: '0'),
            ]
          }
        }
      }
    }
    success {
      script {
        if (env.TRAIN_COUNT && env.TRAIN_COUNT != '0') {
          build job: env.JOB_NAME, wait: false, parameters: [string(name: 'MAX_PRS', value: '0')]
        }
      }
    }
  }
}
