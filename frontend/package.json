{
  "name": "codemit-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --port 3000",
    "build": "next build --turbopack",
    "start": "next start --port 3000",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run",
    "test": "pnpm run test:unit && pnpm run test:public && pnpm run test:operator && pnpm run test:classroom",
    "test:public": "scripts/e2e-two-pass.sh public",
    "test:operator": "scripts/e2e-two-pass.sh operator",
    "test:classroom": "scripts/e2e-two-pass.sh classroom",
    "generate:api": "pnpm --dir ../packages/bff-client generate:api"
  },
  "dependencies": {
    "@codemit/banned-words": "workspace:*",
    "@codemit/bff-client": "workspace:*",
    "@codemit/bff-shared": "workspace:*",
    "@codemit/markdown": "workspace:*",
    "@sentry/nextjs": "^10.74.0",
    "import-in-the-middle": "3.5.1",
    "next": "^15.5.0",
    "openapi-fetch": "^0.13.8",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "require-in-the-middle": "8.0.1"
  },
  "devDependencies": {
    "@codemit/route-audit": "workspace:*",
    "@playwright/test": "^1.50.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.10.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "postcss": "^8.5.26",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.7.0",
    "vitest": "^5.0.0"
  },
  "packageManager": "pnpm@10.33.0"
}
