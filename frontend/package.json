{
  "name": "laurio-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --port 3000",
    "build": "next build",
    "start": "next start --port 3000",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run",
    "test": "pnpm run test:unit && pnpm run test:public && pnpm run test:operator",
    "test:public": "playwright test --project=public --grep-invert @exclusive && playwright test --project=public --grep @exclusive --workers=1",
    "test:operator": "playwright test --project=operator --grep-invert @exclusive && playwright test --project=operator --grep @exclusive --workers=1",
    "generate:api": "pnpm --dir ../packages/bff-client generate:api"
  },
  "dependencies": {
    "@laurio/bff-client": "workspace:*",
    "@laurio/bff-shared": "workspace:*",
    "next": "^15.5.0",
    "openapi-fetch": "^0.13.8",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@laurio/route-audit": "workspace:*",
    "@playwright/test": "^1.50.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.10.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "postcss": "^8.5.26",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.7.0",
    "vitest": "^5.0.0"
  },
  "packageManager": "pnpm@10.33.0"
}
