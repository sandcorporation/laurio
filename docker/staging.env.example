# staging 스택의 시크릿 템플릿. 실제 값을 채운 사본은 `docker/.env.staging` 으로 저장한다
# — 그 파일은 절대 커밋하지 않는다(.gitignore 의 `.env.*` 규칙이 막는다. 이 예제 파일
# 자체는 이름이 `.env.` 로 시작하지 않으므로 그 규칙에 걸리지 않고 저장소에 남는다).
#
#   docker compose -f docker/compose.staging.yaml --env-file docker/.env.staging up -d --build
#
# staging은 서브 호스트에 올려 검증하는 용도다(#23) — ADR-0007의 3단계 바인딩
# (dev=Fake → staging=토스 샌드박스/실제 S3·OCI/실제 소셜 로그인 → prod=전부 실물)에서
# 가운데 단계를 담당한다. 값이 비어 있으면 compose가 `${VAR:?...}` 로 기동 자체를
# 거부한다 — dev의 기본값 없이 배포되는 사고를 막기 위해서다.

# --- Django 코어 ---
# `python -c "import secrets; print(secrets.token_urlsafe(64))"` 로 새로 생성한다.
# staging은 production과 달리 강도(50자·고유문자 5종) 가드 대상이 아니지만, 짧은 키를
# 실제로 쓸 이유는 없다.
DJANGO_SECRET_KEY=
# 실제 서브 호스트의 도메인/IP. 콤마로 여러 개 나열 가능.
DJANGO_ALLOWED_HOSTS=laurio.honeycombpizza.link

# --- PostgreSQL (이 스택 전용 — prod DB와 공유하지 않는다) ---
POSTGRES_DB=laurio_staging
POSTGRES_USER=laurio_staging
POSTGRES_PASSWORD=

# --- 스토리지 어댑터 (ADR-0005, ADR-0007) ---
# staging 은 서브 호스트의 MinIO 를 쓴다(S3 호환이라 S3StorageAdapter 그대로 붙는다).
# ADR-0007 의 "staging=실제 S3/OCI" 는 **Fake 가 아닌 실물 스토리지**라는 뜻이고,
# 그 조건을 MinIO 가 만족한다 — 벤더가 AWS 여야 한다는 뜻이 아니었다.
#
# 두 값을 반드시 갈라야 한다. STORAGE_ENDPOINT_URL 은 backend 컨테이너가 붙는
# 주소이고, STORAGE_PUBLIC_ENDPOINT_URL 은 **브라우저가 presigned PUT 을 직접
# 쏘는 주소**다(ADR-0005). dev 에서는 같은 호스트라 이 구분이 드러나지 않았다.
#
# 그리고 브라우저가 다른 오리진으로 PUT 하므로 **MinIO 쪽에 CORS 허용이 필요하다**
# (LAURIO_WEB_ORIGIN 을 허용 오리진으로). 없으면 업로드가 브라우저에서 막힌다.
STORAGE_BUCKET=laurio-staging
STORAGE_ENDPOINT_URL=https://storage.honeycombpizza.link
STORAGE_PUBLIC_ENDPOINT_URL=https://storage.honeycombpizza.link
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_REGION=

# --- Authentication (ADR-0012) ---
JWT_SIGNING_KEY=

# --- 본인확인 어댑터 (ADR-0011, ADR-0007) ---
VERIFICATION_ENCRYPTION_KEY=

# --- 결제 · Escrow (ADR-0007, ADR-0008): 토스 "샌드박스" 자격증명 ---
# PAYMENT_ADAPTER_MODE/PAYOUT_ADAPTER_MODE/SELLER_ADAPTER_MODE 자체는 compose
# 파일이 real로 고정한다 — 여기서는 그 real 어댑터가 실제로 부를 샌드박스
# 엔드포인트·시크릿키만 채운다. Seller 등록(#50, ADR-0020)은 지급대행과 같은
# 토스 자격증명을 쓰므로 별도 키가 없다 — 실물 어댑터가 붙으면(#57) 이 절이
# 그대로 재사용된다.
# 절대 실물(live) 키를 여기 넣지 않는다 — 이 파일은 검증용 서브 호스트로 나간다.
PAYMENT_WEBHOOK_SECRET=
PAYOUT_WEBHOOK_SECRET=
TOSS_SANDBOX_SECRET_KEY=

# --- 내부 인증(스케줄러 틱, ADR-0003) ---
# 21일 시나리오를 몇 초로 재현하려고 운영자가 이 토큰으로 POST /api/internal/tick 을
# 수동으로 쏜다 — dev 기본값과 겹치지 않는, 이 스택 전용 값으로 채운다.
INTERNAL_API_TOKEN=

# --- 프론트엔드 BFF (ADR-0016) ---
# frontend/lib/auth/origin.ts의 CSRF Origin 검증이 쓰는 값이다. 비어 있으면 요청의
# Host 헤더로 오리진을 유도하는데, 그 폴백은 리버스 프록시가 X-Forwarded-Proto를
# 빠뜨리는 순간 브라우저의 실제 Origin과 어긋나 모든 변경 요청(POST/PUT/PATCH/
# DELETE)이 403이 된다 — fail-closed라 보안 구멍은 아니지만 로그인부터 아무것도
# 안 되는 사고다. frontend/instrumentation.ts가 LAURIO_DEPLOYMENT_TARGET=staging
# 인데 이 값이 비어 있으면 부팅 자체를 거부한다. compose.staging.yaml의 frontend
# 서비스가 이 값을 그대로 소비한다(FE-13, #38) — 실제 서브 호스트의 origin
# (예: https://staging.laurio.example)을 채운다.
# 운영자 앱의 오리진. 비면 백엔드가 부팅을 거부한다.
#
# **지금은 공개 프론트와 같은 값이다** — 운영자 앱(ADR-0019)이 아직 없기 때문이다.
# 그동안 두 신뢰 경계가 한 오리진을 공유하므로, 공개 프론트 오리진에서 온 요청이
# 운영자 경로의 Origin 검사를 통과한다. Operator 인증(세션 + is_staff)이 여전히
# 막고 있으므로 구멍은 아니지만 좋은 모양도 아니다 — 운영자 앱이 생기면
# operator.laurio.honeycombpizza.link 같은 별도 오리진으로 옮긴다.
LAURIO_OPERATOR_ORIGIN=https://laurio.honeycombpizza.link
LAURIO_WEB_ORIGIN=https://laurio.honeycombpizza.link

# --- LLM 채점 · AI grill 어댑터 (ADR-0006/0007/0014) ---
# 둘 다 OpenAI 로 간다. 채점은 소스 200KB(scoring/source_selection.py 의
# MAX_SOURCE_BYTES)를 읽고 **구조화된 판정(JSON)** 을 내야 하는데, Score 는 불변이라
# 재채점 경로가 없다(ADR-0006) — 한 번 잘못 나오면 이의 심판으로만 되돌린다. 그래서
# 구조화 출력의 엄격함이 이 어댑터의 핵심 요구사항이다.
#
# **개발자 소스코드가 외부 벤더로 전송된다.** ADR-0014 는 "선정 전까지 Sponsor 에게
# 감춘다"만 정했고 벤더 처리에 대해서는 말하지 않는다 — 약관·고지 항목으로 남아 있다.
OPEN_AI_API_KEY=

# --- 알림 채널 어댑터 (ADR-0007/0009) ---
# 실제 카카오 알림톡/SMS·LMS 벤더 연동은 아직 구현되지 않았다 — 그렇다고 compose
# 파일에 존재하지 않는 클래스 이름을 하드코딩하지 않는다(코디네이터 리뷰 지적).
# 그 어댑터가 구현되면 그 dotted path를 아래 세 값에 채운다. 그 전까지는 이 값을
# 비워 둘 수 없다 — compose가 `${VAR:?...}`로 기동을 거부해, "알림이 조용히
# 아무것도 안 하는 채로 배포됐다"는 사고를 막는다.
# 순서를 정했다(ADR-0009): SMS/LMS 를 먼저 붙이고 알림톡은 승인이 나오는 대로 붙인다.
# 알림톡에는 사업자등록·카카오 채널 개설·템플릿 사전심사가 선행되어야 하는데 그
# 일정을 우리가 통제하지 못하기 때문이다. ADR-0009 가 이미 "알림톡 실패 시 SMS/LMS
# 로 대체발송"을 정해 두었으므로, 순서가 바뀌어도 설계가 깨지지는 않는다 — 다만
# 알림톡을 붙이기 전까지는 **도달 콜백이 없다**(그것이 알림톡을 주채널로 고른 이유다).
NOTIFICATION_ALIMTALK_ADAPTER=
NOTIFICATION_SMS_ADAPTER=
NOTIFICATION_LMS_ADAPTER=
NOTIFICATION_VENDOR_API_KEY=

# --- 스케줄러(ADR-0003) ---
# redis/celery-worker/celery-beat는 compose.staging.yaml이 컨테이너 3개로 직접
# 띄운다 — 여기서 채울 시크릿은 없다. INTERNAL_API_TOKEN(위)만 세 서비스가 공유한다.
