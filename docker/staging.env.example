# staging 스택의 시크릿 템플릿. 실제 값을 채운 사본은 `docker/.env.staging` 으로 저장한다
# — 그 파일은 절대 커밋하지 않는다(.gitignore 의 `.env.*` 규칙이 막는다. 이 예제 파일
# 자체는 이름이 `.env.` 로 시작하지 않으므로 그 규칙에 걸리지 않고 저장소에 남는다).
#
#   docker compose -f docker/compose.staging.yaml --env-file docker/.env.staging up -d --build
#
# staging은 서브 호스트에 올려 검증하는 용도다(#23) — ADR-0007의 3단계 바인딩
# (dev=Fake → staging=토스 샌드박스/실제 S3·OCI/실제 소셜 로그인 → prod=전부 실물)에서
# 가운데 단계를 담당한다. 값이 비어 있으면 compose가 `${VAR:?...}` 로 기동 자체를
# 거부한다 — dev의 기본값 없이 배포되는 사고를 막기 위해서다.

# --- Django 코어 ---
# `python -c "import secrets; print(secrets.token_urlsafe(64))"` 로 새로 생성한다.
# staging은 production과 달리 강도(50자·고유문자 5종) 가드 대상이 아니지만, 짧은 키를
# 실제로 쓸 이유는 없다.
DJANGO_SECRET_KEY=
# 실제 서브 호스트의 도메인/IP. 콤마로 여러 개 나열 가능.
#
# **`backend`를 반드시 포함한다**(#70 코드리뷰 지적). frontend·operator 두 BFF가
# compose 네트워크 안에서 `http://backend:8000`으로 붙는다(LAURIO_API_BASE_URL,
# compose.staging.yaml) — 그 요청의 Host 헤더가 `backend`이므로, 이 목록에
# 없으면 Django가 모든 요청을 `DisallowedHost` 400으로 거부한다. 컨테이너는
# 셋 다 떠 있는데 로그인도 healthz 프로브도 전부 400이 되는 조용한 사고다 —
# "이제 배포 가능하다"고 예제를 채워도 이 값이 비어 있으면 아무것도 안 된다.
#
# **백엔드 서브도메인도 반드시 포함한다.** 벤더 웹훅(토스 결제·지급대행·Seller)이
# 그 호스트로 들어온다 — `http://backend:8000`은 compose 네트워크 안 이름이라
# 벤더가 닿지 못하므로 백엔드는 공개 호스트가 따로 있어야 하고, 그 Host 헤더가
# 이 목록에 없으면 웹훅이 전부 400으로 거절된다. 그러면 원장에 예치·지급 분개가
# 남지 않는데 컨테이너는 멀쩡히 떠 있다 — 위 주석이 말한 것과 같은 종류의
# 조용한 사고이고, 이번엔 돈이 걸려 있다.
DJANGO_ALLOWED_HOSTS=api.laurio.honeycombpizza.link,laurio.honeycombpizza.link,backend

# --- PostgreSQL (이 스택 전용 — prod DB와 공유하지 않는다) ---
POSTGRES_DB=laurio_staging
POSTGRES_USER=laurio_staging
POSTGRES_PASSWORD=

# --- 스토리지 어댑터 (ADR-0005, ADR-0007) ---
# staging 은 서브 호스트의 MinIO 를 쓴다(S3 호환이라 S3StorageAdapter 그대로 붙는다).
# ADR-0007 의 "staging=실제 S3/OCI" 는 **Fake 가 아닌 실물 스토리지**라는 뜻이고,
# 그 조건을 MinIO 가 만족한다 — 벤더가 AWS 여야 한다는 뜻이 아니었다.
#
# 두 값을 반드시 갈라야 한다. STORAGE_ENDPOINT_URL 은 backend 컨테이너가 붙는
# 주소이고, STORAGE_PUBLIC_ENDPOINT_URL 은 **브라우저가 presigned PUT 을 직접
# 쏘는 주소**다(ADR-0005). dev 에서는 같은 호스트라 이 구분이 드러나지 않았다.
#
# 그리고 브라우저가 다른 오리진으로 PUT 하므로 **MinIO 쪽에 CORS 허용이 필요하다**
# (LAURIO_WEB_ORIGIN 을 허용 오리진으로). 없으면 업로드가 브라우저에서 막힌다.
STORAGE_BUCKET=laurio-staging
STORAGE_ENDPOINT_URL=https://storage.honeycombpizza.link
STORAGE_PUBLIC_ENDPOINT_URL=https://storage.honeycombpizza.link
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_REGION=

# --- Authentication (ADR-0012) ---
JWT_SIGNING_KEY=

# --- 카카오 OAuth 앱 자격증명 (#95/#96, spec #92) ---
# authorize 리다이렉트・code→token 교환은 프론트엔드 BFF가 진다(frontend/
# lib/auth/kakao.ts) — backend·frontend 두 서비스가 이 세 값을 같은 줄에서
# 나눠 읽는다(compose.staging.yaml의 x-backend-env 앵커와 frontend 서비스).
# 카카오 개발자 콘솔(REST API 키 = client_id, Client Secret)에서 발급한다.
# 비어 있으면 compose가 `${VAR:?...}`로 기동을 거부한다 — SOCIAL_AUTH_MODE=real
# 인데 이 값들이 없으면 로그인 버튼이 컨테이너가 뜬 채로 항상 실패하기
# 때문이다(#83과 같은 규율).
#
# **KAKAO_REDIRECT_URI는 카카오 콘솔에 등록한 값과 정확히 같아야 한다** — 한
# 글자만 달라도 카카오가 code→token 교환을 거절한다. staging 도메인이
# laurio.honeycombpizza.link로 정해졌으므로(#52) 이 값은
# https://laurio.honeycombpizza.link/api/auth/social/kakao/callback 이다.
KAKAO_REST_API_KEY=
KAKAO_SECRET_KEY=
KAKAO_REDIRECT_URI=https://laurio.honeycombpizza.link/api/auth/social/kakao/callback

# --- GitHub·구글 OAuth 앱 자격증명 (#189, 선택) ---
# 카카오와 달리 **비워 둬도 기동을 막지 않는다** — 사람이 아직 GitHub·구글
# OAuth 앱을 등록하지 않았기 때문이다(이 티켓의 "사람이 먼저 해야 하는 것").
# 비어 있으면 frontend/lib/auth/{github,google}.ts의 readGithubOAuthConfig/
# readGoogleOAuthConfig가 null을 돌려주고, 로그인 화면의 해당 버튼이 "준비
# 중"으로 남는다(frontend/app/login/page.tsx) — 컨테이너는 정상 기동한다.
# 값을 채우고 배포하면 코드를 더 고치지 않아도 그 버튼이 실제 링크가 된다.
#
# GitHub: https://github.com/settings/developers 에서 OAuth App을 만들고
# Authorization callback URL을 REDIRECT_URI와 정확히 같게 등록한다.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=https://laurio.honeycombpizza.link/api/auth/social/github/callback
# 구글: Google Cloud Console > API 및 서비스 > 사용자 인증 정보에서 OAuth
# 클라이언트 ID(웹 애플리케이션)를 만들고 승인된 리디렉션 URI를 REDIRECT_URI와
# 정확히 같게 등록한다.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://laurio.honeycombpizza.link/api/auth/social/google/callback

# --- 본인확인 어댑터 (ADR-0011, ADR-0007, ADR-0024) ---
# #85로 실물 PortOne V2 통합인증 어댑터가 생겼다 — 아래 값을
# verification.adapters.PortOneV2VerificationAdapter로 채운다. 비워 둘 수
# 없다 — compose가 `${VAR:?...}`로 기동을 거부해, "본인확인이 조용히 죽은 채로
# 배포됐다"는 사고를 막는다.
VERIFICATION_ADAPTER_MODE=verification.adapters.PortOneV2VerificationAdapter
# 실명·생년월일·CI/DI를 저장 전 암호화하는 대칭키(ADR-0011). **아무 문자열이나
# 넣으면 안 된다** — Fernet 키여야 하고, 아니면 부팅이 거부된다. 예전에는 "비어
# 있는지"만 검사해서, 사람이 임의 문자열을 채운 staging 이 멀쩡히 뜬 뒤 본인확인이
# **성공하는 순간** 500 이 났다(실명을 암호화하려다 죽는다). 이렇게 만든다:
#
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#
# 이 키를 잃으면 저장된 실명·CI/DI를 복호화할 수 없다 — 바꾸려면 재암호화가 필요하다.
VERIFICATION_ENCRYPTION_KEY=

# 포트원 V2 서버-투-서버 조회 자격증명(GET /identity-verifications/{id}) — 콜백
# URL이 없어 도메인·TLS 없이도 동작한다. 채널은 KG이니시스 통합인증이고, 카카오는
# CI를 안 줘서 인증 수단에서 뺐다(ADR-0024, #84의 VerificationMissingCIError가
# 그 설정이 되돌려져도 안전하게 막는다).
PORT_ONE_V2_STORE_ID=
PORT_ONE_V2_SECRET_KEY=
# 브라우저 SDK가 인증창을 열 때 쓰는 채널키 — compose의 frontend 서비스가
# build.args로 이 값을 NEXT_PUBLIC_PORTONE_CHANNEL_KEY에 그대로 주입한다
# (#85 코드리뷰 지적 2·7 — 이 값을 비워 두면 빌드 시점에 인라인될 값이 없어
# "실제 본인확인하기" 버튼 자체가 조용히 렌더링되지 않는다).
KG_INICIS_CHANNEL_KEY=

# --- 결제 · Escrow (ADR-0007, ADR-0008): 토스 "샌드박스" 자격증명 ---
# #87(결제)·#57(지급대행 · Seller 등록) 실물 어댑터가 이 값들을 쓴다 — 위
# VERIFICATION_ADAPTER_MODE와 같은 이유로 이 값들도 비워 둘 수 없다.
PAYMENT_ADAPTER_MODE=payments.adapters_toss.TossPGAdapter
PAYOUT_ADAPTER_MODE=payouts.adapters_toss.TossPayoutAdapter
SELLER_ADAPTER_MODE=payouts.adapters_toss.TossSellerAdapter
# 아래는 그 real 어댑터가 실제로 부를 샌드박스 엔드포인트·시크릿키다. 절대
# 실물(live) 키를 여기 넣지 않는다 — 이 파일은 검증용 서브 호스트로 나간다.
PAYMENT_WEBHOOK_SECRET=
PAYOUT_WEBHOOK_SECRET=
TOSS_SANDBOX_SECRET_KEY=
# 결제창 브라우저 SDK가 쓰는 공개 키(#112, 토스 개발자센터 > API 키) —
# TOSS_SANDBOX_SECRET_KEY와 짝이지만 별개의 값이다(이건 브라우저 번들에
# 그대로 노출된다 — 시크릿 키와 달리 노출돼도 되는 값이다). compose.staging.yaml
# 의 frontend build.args가 NEXT_PUBLIC_TOSS_CLIENT_KEY로 그대로 인라인한다.
# **비워 두면 compose 자체가 기동을 거부한다(#115)** — 이 값은 빌드타임에
# 브라우저 번들에 굳어 런타임에 확인할 기회가 없으므로, 부팅 시점 가드
# (frontend/instrumentation.ts)가 컨테이너를 그 자리에서 죽인다. 배포
# 환경에서 PAYMENT_ADAPTER_MODE는 언제나 실물 어댑터를 가리켜야 하므로
# (#83이 fake를 거부한다) 위젯은 반드시 쓰인다 — "값이 비었는데 그 모드가
# 실물이면 화면에서 드러난다"는 예전 문구는 더는 맞지 않는다. 그 드러남이
# 사용자가 결제하기를 누른 순간이었던 사고(spec #110)를 막으려는 것이
# 이 티켓의 존재 이유다.
TOSS_SANDBOX_CLIENT_KEY=
# 셀러 등록·수정·지급 요청 세 API가 요구하는 JWE 암호화 키(#57) — 64자 hex.
# TOSS_SANDBOX_SECRET_KEY와 별개의 값이다(토스 개발자센터 > 지급대행 설정에서
# 발급). payout.changed/seller.changed 웹훅 서명 검증에도 같은 키를 쓴다.
TOSS_API_SECURE_KEY=

# --- 내부 인증(스케줄러 틱, ADR-0003) ---
# 21일 시나리오를 몇 초로 재현하려고 운영자가 이 토큰으로 POST /api/internal/tick 을
# 수동으로 쏜다 — dev 기본값과 겹치지 않는, 이 스택 전용 값으로 채운다.
INTERNAL_API_TOKEN=

# --- 프론트엔드 BFF (ADR-0016) ---
# frontend/lib/auth/origin.ts의 CSRF Origin 검증이 쓰는 값이다. 비어 있으면 요청의
# Host 헤더로 오리진을 유도하는데, 그 폴백은 리버스 프록시가 X-Forwarded-Proto를
# 빠뜨리는 순간 브라우저의 실제 Origin과 어긋나 모든 변경 요청(POST/PUT/PATCH/
# DELETE)이 403이 된다 — fail-closed라 보안 구멍은 아니지만 로그인부터 아무것도
# 안 되는 사고다. frontend/instrumentation.ts가 LAURIO_DEPLOYMENT_TARGET=staging
# 인데 이 값이 비어 있으면 부팅 자체를 거부한다. compose.staging.yaml의 frontend
# 서비스가 이 값을 그대로 소비한다(FE-13, #38) — 실제 서브 호스트의 origin
# (예: https://staging.laurio.example)을 채운다.
# 운영자 앱의 오리진(#70). 비면 백엔드도 운영자 앱(operator/instrumentation.ts)도
# 부팅을 거부한다. **공개 프론트와 같은 값을 쓰지 않는다** — 운영자 앱은 이제
# compose.staging.yaml의 별도 서비스(operator)로 뜬다. 두 신뢰 경계가 한 오리진을
# 공유하던 과거 임시 상태(#43 당시 주석)는 끝났다: 별도 서브도메인으로 갈라야
# 공개 앱이 뚫려도 브라우저가 운영자 세션 쿠키를 그 오리진으로 보내지 않는다는
# 구조적 사실이 성립한다(스펙 #58 "두 개의 오리진은 비용이면서 방어다").
#
# compose.staging.yaml의 backend 서비스(OPERATOR_WEB_ORIGIN)와 operator 서비스가
# 이 **한 값**을 같은 줄에서 나눠 읽는다 — 둘을 따로 채워서 어긋나는 사고 자체를
# 여기서 구조적으로 막는다(이 저장소가 이미 두 번 겪은 실패, CLAUDE.md).
#
# **`operator.laurio.honeycombpizza.link`로 둔다 — 존재하지 않는 서브도메인을
# 지어내지 않는다**(#70 코드리뷰 지적). 실제로 이 값이 무엇이어야 하는지는
# 사람이 DNS·리버스 프록시를 확정할 때 정할 몫이다. **이 값이 실제로 프록시가
# 서빙하는 이름과 다르면, 브라우저가 보내는 실제 Origin과 이 설정값이 갈려
# 로그인을 포함한 모든 운영자 변경 요청이 조용히 403이 된다** — 바로 이 티켓이
# 막겠다고 한 사고이므로, 배포 직전에 실제 도메인과 반드시 대조해야 한다.
LAURIO_OPERATOR_ORIGIN=https://operator.laurio.honeycombpizza.link
LAURIO_WEB_ORIGIN=https://laurio.honeycombpizza.link

# --- LLM 채점 · AI grill 어댑터 (ADR-0006/0007/0014) ---
# 둘 다 OpenAI 로 간다. 채점은 소스 200KB(scoring/source_selection.py 의
# MAX_SOURCE_BYTES)를 읽고 **구조화된 판정(JSON)** 을 내야 하는데, Score 는 불변이라
# 재채점 경로가 없다(ADR-0006) — 한 번 잘못 나오면 이의 심판으로만 되돌린다. 그래서
# 구조화 출력의 엄격함이 이 어댑터의 핵심 요구사항이다.
#
# **개발자 소스코드가 외부 벤더로 전송된다.** ADR-0014 는 "선정 전까지 Sponsor 에게
# 감춘다"만 정했고 벤더 처리에 대해서는 말하지 않는다 — 약관·고지 항목으로 남아 있다.
#
# AI 채점의 실물 어댑터는 scoring.adapters.OpenAIScoringAdapter다(#88). AI
# grill의 실물 어댑터는 contests.requirement_chat.OpenAIRequirementChatAdapter다
# (#55) — 둘 다 아래 OPEN_AI_API_KEY 하나를 공유한다(벤더 하나, 용도 둘).
LLM_ADAPTER_MODE=scoring.adapters.OpenAIScoringAdapter
LLM_REQUIREMENT_CHAT_ADAPTER_MODE=contests.requirement_chat.OpenAIRequirementChatAdapter
OPEN_AI_API_KEY=
# scoring.adapters.OpenAIScoringAdapter의 선택 설정(#88 코드리뷰 지적 6) — 비워
# 두면 기본값(모델 gpt-4o-mini, temperature 0)을 쓴다.
LLM_OPENAI_MODEL=gpt-4o-mini
LLM_OPENAI_TEMPERATURE=0
# contests.requirement_chat.OpenAIRequirementChatAdapter의 전용 temperature다
# (#55 코드리뷰 지적 4) — 위 LLM_OPENAI_TEMPERATURE(채점)와 절대 같은 키를
# 쓰지 않는다. 비우면 기본값 0.7을 쓴다.
LLM_REQUIREMENT_CHAT_OPENAI_TEMPERATURE=0.7

# --- 알림 채널 어댑터 (ADR-0007/0009) ---
# 실제 카카오 알림톡/SMS·LMS 벤더 연동은 아직 구현되지 않았다 — 그렇다고 compose
# 파일에 존재하지 않는 클래스 이름을 하드코딩하지 않는다(코디네이터 리뷰 지적).
# 그 어댑터가 구현되면 그 dotted path를 아래 세 값에 채운다. 그 전까지는 이 값을
# 비워 둘 수 없다 — compose가 `${VAR:?...}`로 기동을 거부해, "알림이 조용히
# 아무것도 안 하는 채로 배포됐다"는 사고를 막는다.
# 순서를 정했다(ADR-0009): SMS/LMS 를 먼저 붙이고 알림톡은 승인이 나오는 대로 붙인다.
# 알림톡에는 사업자등록·카카오 채널 개설·템플릿 사전심사가 선행되어야 하는데 그
# 일정을 우리가 통제하지 못하기 때문이다. ADR-0009 가 이미 "알림톡 실패 시 SMS/LMS
# 로 대체발송"을 정해 두었으므로, 순서가 바뀌어도 설계가 깨지지는 않는다 — 다만
# 알림톡을 붙이기 전까지는 **도달 콜백이 없다**(그것이 알림톡을 주채널로 고른 이유다).
# SMS/LMS는 실물 어댑터가 있다(#51): notifications.adapters_aligo.AligoSmsAdapter /
# AligoLmsAdapter. 알림톡은 승인 전까지 notifications.adapters_aligo.AligoAlimtalkAdapter
# 를 채운다 — 항상 실패를 돌려줘 SMS로 대체발송한다(ADR-0009).
#
# 이 세 값을 채우는 것만으로는 알림이 나가지 않는다(#51 코드리뷰 지적 1) —
# 벤더가 보낼 대상 번호(accounts.models.PhoneContact)가 있어야 한다. 이 값은
# verification.api.verify가 본인확인 응답(휴대폰 본인확인이 이미 필수다,
# ADR-0011)에 실려 온 phoneNumber로 자동으로 채운다. 그러니 이 세 어댑터가
# 실제로 문자를 보내는 첫 대상은 "이 배포 이후 본인확인을 새로 완료한
# 사용자"다 — 이미 본인확인을 마친 기존 계정에는 벤더가 phoneNumber를 준
# 적이 없으므로 PhoneContact가 비어 있고, 그 계정으로는 알림이 계속 실패로
# 끝난다(벤더를 부르지 않고 "등록된 전화번호가 없다"로 즉시 실패한다 — 과금은
# 없다).
NOTIFICATION_ALIMTALK_ADAPTER=notifications.adapters_aligo.AligoAlimtalkAdapter
NOTIFICATION_SMS_ADAPTER=notifications.adapters_aligo.AligoSmsAdapter
NOTIFICATION_LMS_ADAPTER=notifications.adapters_aligo.AligoLmsAdapter
# 알리고(Aligo) 자격증명(#51) — 위 세 어댑터가 공유한다.
ALIGO_API_KEY=
ALIGO_USER_ID=
ALIGO_SENDER_PHONE_NUMBER=

# --- 스케줄러(ADR-0003) ---
# redis/celery-worker/celery-beat는 compose.staging.yaml이 컨테이너 3개로 직접
# 띄운다 — 여기서 채울 시크릿은 없다. INTERNAL_API_TOKEN(위)만 세 서비스가 공유한다.
