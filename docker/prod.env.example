# production 스택의 시크릿 템플릿. 실제 값을 채운 사본은 `docker/.env.prod` 로 저장한다
# — 그 파일은 절대 커밋하지 않는다(.gitignore 의 `.env.*` 규칙이 막는다. 이 예제 파일
# 자체는 이름이 `.env.` 로 시작하지 않으므로 그 규칙에 걸리지 않고 저장소에 남는다).
#
#   docker compose -f docker/compose.prod.yaml --env-file docker/.env.prod up -d --build
#
# production은 AWS/Oracle을 타깃으로 한다(#23) — 이 compose 파일은 그 위에서 그대로
# 돌리거나(단일 VM 배포), 실제로는 ECS/OKE 등 관리형 오케스트레이터가 여기 정의된
# 환경변수 바인딩만 그대로 가져가는 참조 템플릿으로 쓰일 수 있다. 값이 비어 있으면
# compose가 `${VAR:?...}` 로 기동 자체를 거부한다.

# --- Django 코어 ---
# config/settings.py가 production에서 강제한다: 50자 이상 · 고유 문자 5종 이상 ·
# "django-insecure-" 접두 아님. `python -c "import secrets; print(secrets.token_urlsafe(64))"`
# 로 새로 생성한다. dev 등 다른 환경과 절대 같은 값을 쓰지 않는다.
DJANGO_SECRET_KEY=
# 실제 운영 도메인. 콤마로 여러 개 나열 가능. "*" 를 쓰지 않는다.
#
# **`backend`를 반드시 함께 나열한다**(#70 코드리뷰 지적) — frontend·operator 두 BFF가 compose 네트워크 안에서
# `http://backend:8000`으로 붙어 Host 헤더가 `backend`가 되고, 이 목록에 없으면
# Django가 그 요청을 `DisallowedHost` 400으로 거부한다. 예: `api.codemit.example,backend`.
# 값을 비워 둔 채로는 두지 않는다 — compose가 `${VAR:?...}`로 기동을 거부한다.
#
# **백엔드 공개 호스트를 반드시 포함한다.** 벤더 웹훅(토스 결제·지급대행·Seller)이
# 그 호스트로 들어오는데, `http://backend:8000`은 compose 네트워크 안 이름이라
# 벤더가 닿지 못한다. 그 Host 가 이 목록에 없으면 웹훅이 전부 400으로 거절되고,
# 원장에 예치·지급 분개가 남지 않는다 — 컨테이너는 멀쩡히 떠 있는 채로.
# 두 BFF 가 붙는 `backend` 도 함께 넣는다(위 주석 참고).
#   예: api.codemit.example,codemit.example,backend
DJANGO_ALLOWED_HOSTS=

# 공모전 제품 스위치 — 「공모전 / 유료 공모전」 둘(#271/#413, ADR-0048) — 둘 다
# 선택값이다. `compose.prod.yaml`이 공모전은 기본 켜짐, 유료만
# 기본 false로 겹쳐 쓴다(돈을 다루지 않는 무료 공모전은 열고, 운영하지 않는
# 유료 결제 경로는 닫아 둔다) — 비워 두면 prod 는 그 상태로 뜬다. 유료를 켜려면
# 이 줄의 주석을 풀고 true를 준다 — backend와 frontend(빌드 인자)가 같은 값을
# 나눠 읽으므로 frontend도 재빌드해야 반영된다.
# CODEMIT_CONTEST_PRODUCT_ENABLED=true
# CODEMIT_PAID_CONTEST_PRODUCT_ENABLED=true

# --- PostgreSQL (관리형 RDS/OCI DB 등을 권장 — 이 compose의 db 서비스는 자체 호스팅
# 옵션일 뿐이다) ---
POSTGRES_DB=codemit
POSTGRES_USER=codemit
POSTGRES_PASSWORD=
# 관리형 DB를 쓰면 POSTGRES_HOST/POSTGRES_PORT 를 그 엔드포인트로 덮어써야 한다
# (compose.prod.yaml 의 **pgbouncer** 서비스 environment 참고, #453/#458 —
# 연결 풀러가 그 뒤에 붙는다. backend·celery·events 는 이제 이 값이 아니라
# 고정된 로컬 pgbouncer 를 가리키므로 이 값을 바꿔도 그 넷의 설정은 그대로다).

# --- 스토리지 어댑터 (ADR-0005, ADR-0007): OCI Object Storage (S3 호환 API) ---
# prod 스토리지는 OCI Object Storage 다(2026-09-14 준비). 버킷·서비스 사용자·정책은 이 저장소
# 밖에서 만들었다 — 이름은 서비스 새 이름(Codemit)을 따른다:
#   버킷 codemit-prod(비공개), codemit-prod-public-images(객체 익명 읽기, 목록 불가)
#   서비스 사용자·그룹·정책 codemit-prod-storage — 정책이 이 두 버킷의 객체만 허용한다.
# 키(STORAGE_ACCESS_KEY/SECRET_KEY)는 그 서비스 사용자의 고객 비밀 키다 — 개인 계정 키를 쓰지
# 않는다(테넌시 전체 스토리지 권한이 prod 서버에 올라간다). 새로 발급하면 **몇 분 동안
# SignatureDoesNotMatch/403 이 섞여 나온다**(키가 인증 노드에 퍼지는 중) — 고장이 아니다.
#
# CORS 는 설정하지 않는다: OCI S3 호환 API 는 버킷 CORS 규칙(PutBucketCors)을 지원하지 않고,
# 대신 모든 오리진에 Access-Control-Allow-Origin: * 를 돌려준다 — 브라우저 presigned PUT/POST
# 가 그대로 된다(실측). presigned POST 의 크기 상한(#261) 초과는 400 으로 거절된다(실측).
# 어댑터가 boto3 체크섬을 필요할 때만 계산한다(storage/adapters/s3.py) — 기본값(aws-chunked)은
# OCI 가 NotImplemented 로 거절한다.
STORAGE_BUCKET=codemit-prod
STORAGE_ENDPOINT_URL=https://axuhrlainwhc.compat.objectstorage.ap-chuncheon-1.oraclecloud.com
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_REGION=ap-chuncheon-1

# --- 공개 이미지 버킷 (#233, ADR-0032) ---
# Contest 이미지가 사는 버킷 — 위 STORAGE_BUCKET(소스 등, 비공개)과 물리적으로 분리된다.
# 공모전 스위치가 꺼져 있어도 부팅 가드가 이 두 값을 요구한다(config/settings.py).
STORAGE_IMAGES_BUCKET=codemit-prod-public-images
# 서명 없는 기준 주소 — OCI 네이티브 공개 URL 이다(익명 GET 실측, 키의 `:`·`/` 그대로 된다).
# 캐시가 필요해지면 이 버킷을 오리진으로 둔 CDN 주소로 바꾼다.
STORAGE_IMAGES_BASE_URL=https://objectstorage.ap-chuncheon-1.oraclecloud.com/n/axuhrlainwhc/b/codemit-prod-public-images/o

# --- Authentication (ADR-0012) ---
JWT_SIGNING_KEY=

# --- 카카오 OAuth 앱 자격증명 (#95/#96, spec #92) ---
# 값은 프로덕션 카카오 앱(또는 같은 앱의 프로덕션 키)이어야
# 한다. **KAKAO_REDIRECT_URI는 카카오 콘솔에 등록한 값과 정확히 같아야 한다** —
# 한 글자만 달라도 code→token 교환이 거절된다. 프로덕션 도메인이 아직 정해지지
# 않아 이 값은 비워 둔다 — 도메인이 정해지면 콘솔 등록과 함께 채운다.
KAKAO_REST_API_KEY=
KAKAO_SECRET_KEY=
KAKAO_REDIRECT_URI=

# --- GitHub·구글 OAuth 앱 자격증명 (#189, 선택) ---
# 카카오와 달리 비어
# 있어도 기동을 막지 않는다. 값이 없으면 로그인 화면의 GitHub·구글 버튼이
# "준비 중"으로 남는다. 프로덕션 도메인이 정해지면 REDIRECT_URI를 그 도메인의
# /api/auth/social/{github,google}/callback으로, 그리고 각 콘솔(GitHub OAuth
# App, Google Cloud Console)에 등록한 콜백 URL도 같이 채운다 — 프로덕션 OAuth 앱(또는 같은 앱의 프로덕션 자격증명)이어야 한다.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# --- 본인확인 어댑터 (ADR-0011, ADR-0007, ADR-0024) ---
# #85로 실물 PortOne V2 통합인증 어댑터가 생겼다 — 어댑터는
# verification.adapters.PortOneV2VerificationAdapter 이고 아래 자격증명은
# 프로덕션 벤더 계정 값이어야 한다. 비워 둘 수 없다
# — compose가 `${VAR:?...}`로 기동을 거부해, "본인확인이 조용히 죽은 채로
# 배포됐다"는 사고를 막는다.
VERIFICATION_ADAPTER_MODE=verification.adapters.PortOneV2VerificationAdapter
# 실명·생년월일·CI/DI를 저장 전 암호화하는 대칭키(ADR-0011). **아무 문자열이나
# 넣으면 안 된다** — Fernet 키여야 하고, 아니면 부팅이 거부된다. 예전에는 "비어
# 있는지"만 검사해서, 사람이 임의 문자열을 채운 배포가 멀쩡히 뜬 뒤 본인확인이
# **성공하는 순간** 500 이 났다(실명을 암호화하려다 죽는다). 이렇게 만든다:
#
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#
# 이 키를 잃으면 저장된 실명·CI/DI를 복호화할 수 없다 — 바꾸려면 재암호화가 필요하다.
VERIFICATION_ENCRYPTION_KEY=

# 포트원 V2 서버-투-서버 조회 자격증명 — 프로덕션 벤더 계정의 값을 채운다. 채널은 KG이니시스 통합인증이고, 카카오는
# CI를 안 줘서 인증 수단에서 뺐다(ADR-0024).
PORT_ONE_V2_STORE_ID=
PORT_ONE_V2_SECRET_KEY=
# 브라우저 SDK가 인증창을 열 때 쓰는 채널키 — compose의 frontend 서비스가 실행 env
# CODEMIT_PUBLIC_PORTONE_CHANNEL_KEY 로 넘긴다(#711). **비워 두면 compose 가 기동을 거부한다.**
KG_INICIS_CHANNEL_KEY=

# --- 결제 · Escrow (ADR-0007, ADR-0008): 토스 "실물" 자격증명 ---
# 샌드박스 키와 반드시 다른 값이어야 한다 — 같은 값을 쓰면 샌드박스에서
# 검증한 흐름이 실물에서도 똑같이 동작한다고 착각하기 쉽지만, 자격증명이 가리키는
# 엔드포인트 자체가 다르므로 섞이면 즉시 인증 실패로 드러난다(실물 키가 새는 사고와는
# 다른 방향의 실수지만 마찬가지로 이 파일을 분리해 둔 이유다).
# #87(결제)·#57(지급대행 · Seller 등록) 실물 어댑터가 이 값들을 쓴다 — 위
# VERIFICATION_ADAPTER_MODE와 같은 이유로 이 값들도 비워 둘 수 없다.
PAYMENT_ADAPTER_MODE=payments.adapters_toss.TossPGAdapter
PAYOUT_ADAPTER_MODE=payouts.adapters_toss.TossPayoutAdapter
SELLER_ADAPTER_MODE=payouts.adapters_toss.TossSellerAdapter
PAYMENT_WEBHOOK_SECRET=
PAYOUT_WEBHOOK_SECRET=
TOSS_LIVE_SECRET_KEY=
# 결제창 브라우저 SDK가 쓰는 공개 키(#112) — TOSS_LIVE_SECRET_KEY와 짝이지만 별개의 값이고,
# 브라우저에 그대로 노출돼도 되는 값이다. compose 의 frontend 서비스가 실행 env
# CODEMIT_PUBLIC_TOSS_CLIENT_KEY 로 넘기고 루트 레이아웃이 브라우저로 싣는다(#711).
# **비워 두면 compose 자체가 기동을 거부한다(#115)** — 그래도 빈 값으로 뜨면 부팅 가드
# (frontend/instrumentation.ts)가 컨테이너를 그 자리에서 죽인다. 배포 환경은 언제나 실물
# 결제 어댑터라 위젯을 반드시 쓴다(spec #110 — 첫 발견자가 결제하기를 누른 사용자였다).
TOSS_LIVE_CLIENT_KEY=
# 약관·방침이 싣는 문의 주소(개인정보 보호법 제30조 제1항의 필수 기재사항, #472 후속) —
# frontend 가 실행 env CODEMIT_PUBLIC_SUPPORT_EMAIL 로 읽는다(#711). **비워 두면 compose 가
# 기동을 거부한다.** 바꾸면 컨테이너를 다시 띄우면 된다(이미지를 다시 굽지 않는다).
SUPPORT_EMAIL=
# 셀러 등록·수정·지급 요청 세 API가 요구하는 JWE 암호화 키(#57) — 64자 hex.
# TOSS_LIVE_SECRET_KEY와 별개의 값이다. payout.changed/seller.changed 웹훅
# 서명 검증에도 같은 키를 쓴다.
TOSS_API_SECURE_KEY=

# --- 내부 인증(스케줄러 틱 외 5개 내부 스캔, ADR-0003) ---
# celery-worker(beat 를 품는다, #859)만 이 토큰으로 /api/internal/* 을 호출한다 — production은 운영자가 이 엔드포인트를 수동으로 두드릴 일을 상정하지 않고,
# backend 자체도 127.0.0.1에만 publish된다(compose.prod.yaml 참고).
INTERNAL_API_TOKEN=

# --- 프론트엔드 BFF (ADR-0016) ---
# frontend/lib/auth/origin.ts의 CSRF Origin 검증이 쓰는 값이다. 비어 있으면 요청의
# Host 헤더로 오리진을 유도하는데, production은 TLS 종단 리버스 프록시(별도 티켓,
# compose.prod.yaml 상단 주석 참고)를 반드시 앞단에 두므로 그 프록시가
# X-Forwarded-Proto를 빠뜨리거나 Host를 내부 주소로 바꾸면 유도된 오리진이
# 브라우저의 실제 Origin과 어긋나 모든 변경 요청(POST/PUT/PATCH/DELETE)이 403이
# 된다 — fail-closed라 보안 구멍은 아니지만 로그인부터 아무것도 안 되는 사고다.
# frontend/instrumentation.ts가 CODEMIT_DEPLOYMENT_TARGET=production인데 이 값이
# 비어 있으면 부팅 자체를 거부한다. 실제
# 운영 도메인이어야 한다. compose.prod.yaml의 frontend 서비스가 이 값을 그대로
# 소비한다(FE-13, #38).
# 운영자 앱의 오리진(#70). 비면 백엔드도 운영자 앱(operator/instrumentation.ts)도
# 부팅을 거부한다. 공개 앱(CODEMIT_WEB_ORIGIN)과 반드시 다른 서브도메인이어야
# 한다 — 같은 오리진을 쓰면 두 앱이 신뢰 경계를 공유하게 된다(스펙 #58). 실제 운영 도메인이어야 한다.
#
# compose.prod.yaml의 backend 서비스(OPERATOR_WEB_ORIGIN)와 operator 서비스가
# 이 **한 값**을 같은 줄에서 나눠 읽는다 — 둘을 따로 채워서 어긋나는 사고 자체를
# 여기서 구조적으로 막는다(이 저장소가 이미 두 번 겪은 실패, CLAUDE.md).
CODEMIT_OPERATOR_ORIGIN=
CODEMIT_WEB_ORIGIN=
# 강의실 앱의 오리진(#276/#277). 실제
# 운영 도메인이어야 한다. 공개 앱·운영자 앱과 반드시 다른 서브도메인이어야 한다.
CODEMIT_CLASSROOM_ORIGIN=

# 세션 쿠키의 domain 속성(ADR-0038, #273). 실제 운영 도메인의 부모여야 한다. compose.prod.yaml의 frontend
# 서비스가 이 값을 그대로 소비한다. 비면 frontend/instrumentation.ts가 부팅을
# 거부한다.
CODEMIT_SESSION_COOKIE_DOMAIN=

# --- LLM 채점 · AI grill 어댑터 (ADR-0006/0007/0014) ---
# AI 채점의 실물 어댑터는 scoring.adapters.OpenAIScoringAdapter다(#88). AI
# grill의 실물 어댑터는 contests.requirement_chat.OpenAIRequirementChatAdapter다
# (#55) — 둘 다 아래 OPEN_AI_API_KEY 하나를 공유한다(벤더 하나, 용도 둘).
# dev 의 OPEN_AI_API_KEY를 그대로 쓰지 않는다(벤더 계정이 다르다).
LLM_ADAPTER_MODE=scoring.adapters.OpenAIScoringAdapter
# 강의실 채점(#287, #340)은 강사 본인의 키로 돈다(위 LLM_ADAPTER_MODE·
# OPEN_AI_API_KEY와 무관하다) — 이 값은 그 경로가 fake를 쓸지 실물
# (core.llm_scoring.OpenAIScoringAdapter)을 쓸지만 가른다(ADR-0043). 배포
# 환경에서 fake이면 부팅이 거부된다.
CLASSROOM_SCORING_ADAPTER_MODE=core.llm_scoring.OpenAIScoringAdapter
LLM_REQUIREMENT_CHAT_ADAPTER_MODE=contests.requirement_chat.OpenAIRequirementChatAdapter
# 아래 넷은 폴백이다(#922, ADR-0075) — Operator 「운영 설정」에 값이 있으면 그것이 이긴다.
# 운영 설정은 비어 있으면 이 값을 쓰고, 화면에서 「지우기」하면 이 값으로 돌아간다.
OPEN_AI_API_KEY=
# scoring.adapters.OpenAIScoringAdapter의 선택 설정(#88 코드리뷰 지적 6) — 비워
# 두면 기본값(모델 gpt-4o-mini, temperature 0)을 쓴다.
LLM_OPENAI_MODEL=gpt-4o-mini
LLM_OPENAI_TEMPERATURE=0
# contests.requirement_chat.OpenAIRequirementChatAdapter의 전용 temperature다
# (#55 코드리뷰 지적 4) — 위 LLM_OPENAI_TEMPERATURE(채점)와 절대 같은 키를
# 쓰지 않는다. 비우면 기본값 0.7을 쓴다.
LLM_REQUIREMENT_CHAT_OPENAI_TEMPERATURE=0.7

# --- GitHub 저장소 어댑터 (#193, ADR-0007/0027) ---
# 실물 어댑터는 repositories.adapters.GitHubAPIAdapter다.
GITHUB_ADAPTER_MODE=repositories.adapters.GitHubAPIAdapter
# 선택값이다 — 비워 두면 익명 요청으로 동작한다.
GITHUB_API_TOKEN=

# --- 알림 채널 어댑터 (ADR-0007/0009) ---
# 실제 카카오 알림톡/SMS·LMS 벤더 연동은 아직 구현되지 않았다 — compose 파일에
# 존재하지 않는 클래스 이름을 하드코딩하지 않는다(코디네이터 리뷰 지적). 그 어댑터가
# 구현되면 그 dotted path를 아래 세 값에 채운다. 그 전까지는 비워 둘 수 없다 — compose가
# `${VAR:?...}`로 기동을 거부한다.
# SMS/LMS는 실물 어댑터가 있다(#51): notifications.adapters_aligo.AligoSmsAdapter /
# AligoLmsAdapter. 알림톡은 승인 전까지 notifications.adapters_aligo.AligoAlimtalkAdapter
# 를 채운다 — 항상 실패를 돌려줘 SMS로 대체발송한다(ADR-0009).
#
# 이 세 값을 채우는 것만으로는 알림이 나가지 않는다(#51 코드리뷰 지적 1) —
# 벤더가 보낼 대상 번호(accounts.models.PhoneContact)가 있어야 한다. 이 값은
# verification.api.verify가 본인확인 응답(휴대폰 본인확인이 이미 필수다,
# ADR-0011)에 실려 온 phoneNumber로 자동으로 채운다. 그러니 이 세 어댑터가
# 실제로 문자를 보내는 첫 대상은 "이 배포 이후 본인확인을 새로 완료한
# 사용자"다 — 이미 본인확인을 마친 기존 계정에는 벤더가 phoneNumber를 준
# 적이 없으므로 PhoneContact가 비어 있고, 그 계정으로는 알림이 계속 실패로
# 끝난다(벤더를 부르지 않고 "등록된 전화번호가 없다"로 즉시 실패한다 — 과금은
# 없다).
NOTIFICATION_ALIMTALK_ADAPTER=notifications.adapters_aligo.AligoAlimtalkAdapter
NOTIFICATION_SMS_ADAPTER=notifications.adapters_aligo.AligoSmsAdapter
NOTIFICATION_LMS_ADAPTER=notifications.adapters_aligo.AligoLmsAdapter
# 알리고(Aligo) 자격증명(#51).
ALIGO_API_KEY=
ALIGO_USER_ID=
ALIGO_SENDER_PHONE_NUMBER=

# --- 이벤트 버스 (ADR-0046, #380) ---
# 강의실이 새로고침 없이 화면을 갱신하는 실시간 신호(core.events) — 벤더 자격증명이 아니라 우리 자신의 Redis 위에서 도는
# 코드라 환경별로 다를 이유가 없다). 비워 둘 수 없다 — 다른 *_ADAPTER_MODE와
# 같은 이유로 compose가 기동을 거부한다.
EVENT_BUS_ADAPTER_MODE=core.events_redis.RedisEventBus

# --- 공모전 검색 (#450/#451, 부모 #444 스펙, ADR-0007) ---
# compose.prod.yaml의 search 서비스(내부망 전용)가 받는 값이다.
# 비어 있어도(또는 이 파일 전체가 없어도) 부팅이 막히지 않는다 —
# compose.prod.yaml이 컴포즈 레벨 기본값으로 이미 아래와 같은 값을 준다.
SEARCH_ADAPTER_MODE=contests.search_opensearch.OpenSearchContestSearch
OPENSEARCH_URL=http://search:9200

# --- 스케줄러(ADR-0003) ---
# redis/celery-worker(beat 를 `-B` 로 품는다, #859)는 compose.prod.yaml이 컨테이너 2개로 직접 띄운다 —
# 여기서 채울 시크릿은 없다. INTERNAL_API_TOKEN(위)은 worker 가 쓴다.
# 강의실 채점 grader(#584, ADR-0059)도 compose 가 직접 띄운다 — 채울 값이
# 없다. CELERY_TASK_ALWAYS_EAGER 는 여기 넣지 않는다(켜면 부팅이 거부된다).
#
# 이벤트 서비스(events, ADR-0046, #380)도 같은 Redis(EVENT_BUS_REDIS_URL,
# compose.prod.yaml이 redis://redis:6379/2로 직접 준다)를 쓴다 — 여기서
# 채울 시크릿은 없다. 없어도 backend·frontend·operator는 그대로 뜬다 —
# 강의실 화면만 폴링으로 물러난다(ADR-0046 결과).

# --- 오류 수집 (GlitchTip, 2026-09-16) ---
# 오류를 자체 호스팅 GlitchTip(https://glitchtip.honeycombpizza.link)으로 보낸다.
# sentry.io 를 쓰지 않는 이유: 수업 제출물·이름·이메일을 다루는 서버라 오류
# 본문이 바깥 업체로 나가지 않는 편이 낫다. SDK 는 Sentry 것을 그대로 쓴다.
#
# **앱마다 프로젝트(DSN)가 다르다** — GlitchTip 프로젝트에서 복사한다. 비워 두면
# 그 앱은 SDK 가 꺼진 채로 돈다(부팅은 막지 않는다 — 오류 수집이 없어도 서비스는
# 돌아야 한다). 세 앱의 값은 브라우저 번들에 굳으므로 바꾸면 이미지를 다시 굽는다.
#
# 무엇을 보내지 않는지: 세션 리플레이·성능 추적을 켜지 않고, 사용자 식별은 내부
# id 하나뿐이며 이메일·IP·요청 본문·쿠키는 보내지 않는다
# (backend/core/observability.py, <app>/lib/observability/sentry-options.ts).
SENTRY_DSN_BACKEND=
SENTRY_DSN_FRONTEND=
SENTRY_DSN_OPERATOR=
SENTRY_DSN_CLASSROOM=

# --- 방문 메트릭 스니펫 (Sandcorp 공통, #785) ---
# 사용자가 보는 두 앱(frontend·classroom)의 <head> 에 `<script defer src=… data-site="codemit">` 한 줄을
# 싣는다 — operator 는 없다. 비어 있으면 태그 자체가 없다(compose 의 CODEMIT_PUBLIC_METRICS_SNIPPET_URL).
# 운영 값은 `https://metrics.sandcorp.co.kr/m.js`. 스니펫은 쿠키 없이 경로와 유입 경로만 보낸다.
METRICS_SNIPPET_URL=

# --- 이미지 받기 (ghcr, 2026-09-17) ---
# 이 서버는 이미지를 굽지 않고 CI 가 ghcr 에 올린 것을 받는다(deploy.sh 머리 주석).
# ghcr 로그인은 이 파일이 아니라 배포 에이전트 컨테이너의 /root/.docker(named volume)에
# 한 번 저장해 둔다 — scripts/ghcr-setup-wizard.sh 3단계.
#
# **세 앱 이미지는 환경을 모른다**(#711, ADR-0062) — 이미지는 아키텍처로만 갈리고(`<sha>-arm64`),
# 공개 값(Sentry DSN·토스 클라이언트 키·포트원 둘·SUPPORT_EMAIL·공모전 스위치·메트릭 스니펫 주소)은 **이 파일**에서
# compose 의 `CODEMIT_PUBLIC_*` 로 실행 때 들어간다. 값을 바꾸면 deploy.sh 가 컨테이너를 다시 띄우는
# 것으로 끝난다. Sentry release 는 deploy.sh 가 export 하는 배포 커밋(SENTRY_RELEASE)이다.

# 운영 경보(#830, `ops_metrics.alerts`)의 디스코드 웹훅. 비워 두면 보내지 않고 콘솔 /ops 경보 패널에만
# 상태가 남는다. Jenkins 의 `discord-deploy-webhook`(빌드 알림)과는 다른 값이다 — 이 파일에만 둔다.
OPS_ALERT_DISCORD_WEBHOOK_URL=
